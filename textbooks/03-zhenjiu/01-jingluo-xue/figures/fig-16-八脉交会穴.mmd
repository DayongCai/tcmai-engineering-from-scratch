%% 图 16-2 八脉交会穴：八穴通八脉
%% 内容依据：15-第16章-奇经八脉.md §16.1.1
%%   原文「八脉交会穴是奇经八脉与十二经脉之气相通的八个穴位，即公孙通冲脉、内关通阴维脉、
%%   足临泣通带脉、外关通阳维脉、列缺通任脉、照海通阴跷脉、后溪通督脉、申脉通阳跷脉，
%%   临床上既可单独选用，又常上下配穴成对应用」
%% 八组对应关系逐条照录，未增删；四对上下配穴按原文「上下配穴成对应用」并列，
%% 配对组合（公孙配内关、足临泣配外关、列缺配照海、后溪配申脉）为该穴法的通行配伍。
graph LR
    G["公孙"] --> C["冲脉"]
    NK["内关"] --> YW["阴维脉"]

    ZLQ["足临泣"] --> DM["带脉"]
    WG["外关"] --> YANGW["阳维脉"]

    LQ["列缺"] --> REN["任脉"]
    ZH["照海"] --> YINQ["阴跷脉"]

    HX["后溪"] --> DU["督脉"]
    SM["申脉"] --> YANGQ["阳跷脉"]

    G -. "上下配穴" .- NK
    ZLQ -. "上下配穴" .- WG
    LQ -. "上下配穴" .- ZH
    HX -. "上下配穴" .- SM

    classDef acu fill:#f3ede2,stroke:#8a5a2b,stroke-width:1.5px,color:#1f1b16
    classDef mai fill:#eef2e8,stroke:#4a7c59,stroke-width:1.5px,color:#1f1b16
    class G,NK,ZLQ,WG,LQ,ZH,HX,SM acu
    class C,YW,DM,YANGW,REN,YINQ,DU,YANGQ mai
