%% 图 16-1 奇经八脉的功能与正经关系
%% 内容依据：15-第16章-奇经八脉.md §16.1.1
%%   原文「督脉之'督'有总督之意，行于背脊正中，总督一身之阳经；任脉之'任'有妊养、总任之意，
%%   行于腹胸正中，总任一身之阴经；冲脉之'冲'为要冲之意，为'十二经脉之海''血海'；
%%   带脉之'带'指腰带，环腰一周，约束纵行诸经；维脉之'维'有维系、主持之意，阳维维系一身之阳，
%%   阴维维系一身之阴；跷脉之'跷'有足跟、矫捷之意，阴阳跷脉分主肢体两侧，调节下肢运动与寤寐」
%%   「督、任、冲三脉皆起于胞中，同出会阴，称为'一源三歧'」
%% 三大特征同样取自本节：不直属脏腑、无表里配合、除任督外无专属腧穴。
graph TD
    QJ["奇经八脉<br/>别道奇行"]

    QJ --> F1["总督诸阳"]
    QJ --> F2["总任诸阴"]
    QJ --> F3["气血之海"]
    QJ --> F4["约束 · 维系 · 跷捷"]

    F1 --> M1["督脉<br/>行腰背头面正中"]
    F2 --> M2["任脉<br/>行腹胸颈面正中"]
    F3 --> M3["冲脉<br/>与足少阴并行，环绕口唇"]
    F4 --> M4["带脉<br/>环腰一周，约束纵行诸经"]
    F4 --> M5["阴维 · 阳维<br/>维系一身之阴 / 之阳"]
    F4 --> M6["阴跷 · 阳跷<br/>主肢体两侧，调运动与寤寐"]

    M1 -.-> YY["一源三歧<br/>督·任·冲皆起于胞中，同出会阴"]
    M2 -.-> YY
    M3 -.-> YY

    M1 -.-> SJ["十四经<br/>任脉 24 穴 · 督脉 29 穴"]
    M2 -.-> SJ
    M4 -.-> LJ["其余六脉无专属腧穴<br/>经气通于八脉交会穴"]
    M5 -.-> LJ
    M6 -.-> LJ

    QJ -.-> TZ["与正经之别<br/>不直属脏腑<br/>无表里配合<br/>任督之外无专穴"]

    classDef root fill:#eef2e8,stroke:#4a7c59,stroke-width:2px,color:#1f1b16
    classDef fun fill:#f3ede2,stroke:#8a5a2b,stroke-width:1.5px,color:#1f1b16
    classDef mai fill:#fbf8f2,stroke:#b9a992,stroke-width:1.1px,color:#1f1b16
    classDef note fill:#fdf6e8,stroke:#c9a227,stroke-width:1px,color:#6b6156
    class QJ root
    class F1,F2,F3,F4 fun
    class M1,M2,M3,M4,M5,M6 mai
    class YY,SJ,LJ,TZ note
