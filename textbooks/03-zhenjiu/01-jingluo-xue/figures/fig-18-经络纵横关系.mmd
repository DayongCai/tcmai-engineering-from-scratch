%% 图 18-1 经络的纵横关系：根结标本（纵）与气街四海（横）
%% 内容依据：16-第18章-经络的纵横关系.md
%%   §18.1.1 原文「四肢末端是经气所起的根本之处，头、胸、腹部是经气所归的结聚之处」
%%            「十二经脉以四肢为'根'，以头、胸、腹三部为'结'」——四根三结
%%   §18.2.1 原文「气在头者，止之于脑。气在胸者，止之膺与背俞。气在腹者，止之背俞，
%%            与冲脉于脐左右之动脉者。气在胫者，止之于气街，与承山踝上以下」
%%            「横贯脏腑经络，纵分头、胸、腹、胫，是气街理论的核心内容」
%%   §18.3.1 四海与四气街的对应：头气街应髓海、胸气街应气海、腹气街应水谷之海、
%%            胫气街应血海（冲脉）—— 原文见 §18.2.1「气街又与四海相互为用」一段
%% 本图只画两组关系与对应，具体穴位与主治见各节正文。
graph TD
    Z["经络的纵横关系<br/>经气运行的立体格局"]

    Z --> A["纵向 · 上下两极"]
    Z --> H["横向 · 分部汇聚"]

    A --> A1["根结<br/>根：四肢末端（井穴）<br/>结：头、胸、腹三部"]
    A --> A2["标本<br/>本：四肢肘膝以下<br/>标：头面胸背"]

    H --> H1["头气街<br/>止之于脑"]
    H --> H2["胸气街<br/>止之膺与背俞"]
    H --> H3["腹气街<br/>止之背俞与脐旁冲脉"]
    H --> H4["胫气街<br/>止之气冲、承山、踝上以下"]

    H1 -.-> S1["髓海"]
    H2 -.-> S2["气海"]
    H3 -.-> S3["水谷之海"]
    H4 -.-> S4["血海（冲脉）"]

    A1 -.-> K1["四根三结<br/>四肢为根<br/>头胸腹为结"]
    A2 -.-> K2["本在肘膝以下<br/>标在头面胸背<br/>广于根结"]

    classDef root fill:#eef2e8,stroke:#4a7c59,stroke-width:2px,color:#1f1b16
    classDef axis fill:#f3ede2,stroke:#8a5a2b,stroke-width:1.6px,color:#1f1b16
    classDef item fill:#fbf8f2,stroke:#b9a992,stroke-width:1.1px,color:#1f1b16
    classDef sea fill:#fdf6e8,stroke:#c9a227,stroke-width:1.2px,color:#1f1b16
    classDef note fill:#fbf8f2,stroke:#ddd3c4,stroke-width:1px,color:#6b6156
    class Z root
    class A,H axis
    class A1,A2,H1,H2,H3,H4 item
    class S1,S2,S3,S4 sea
    class K1,K2 note
