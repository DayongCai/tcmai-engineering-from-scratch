    classDef feel fill:#eae6f0,stroke:#6a5a8a,stroke-width:1.4px,color:#1f1b16
    classDef whole fill:#f5efe4,stroke:#a08a5a,stroke-width:1.4px,color:#1f1b16
    classDef key fill:#fdf1ef,stroke:#b5443a,stroke-width:1.6px,color:#1f1b16
    class S src
    class A,A1 see
    class B,B1 feel
    class C,C1 whole
