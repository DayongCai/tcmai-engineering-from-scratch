%% 图 1-1 人体组成的层次与九大系统
%% 内容依据：textbooks/09-jichu/01-renti-jiepou-xue/01-第1章-绪论.md §1.1.2
%%   正文原话「细胞是构成人体的基本单位……几种组织按一定的形式组合，构成具有一定形态与
%%   功能特点的器官。功能相关的器官按一定的顺序连接与排列，构成系统」「通常划分为九大系统」
%% 图上不写数值、不写尺寸 —— 与本章「不写数值与单位」的正文口径一致。
graph TD
    C["细胞<br/>构成人体的基本单位"] --> T["组织<br/>形态与功能相近的细胞与细胞间质"]
    T --> O["器官<br/>以一种组织为主，有特定形态与功能"]
    O --> S["系统<br/>功能相关的器官按序连接排列"]
    S --> B["完整机体<br/>各系统相互联系、相互制约"]

    T -.-> T1["上皮组织<br/>保护·分泌·吸收"]
    T -.-> T2["结缔组织<br/>连接·支持·营养·防御"]
    T -.-> T3["肌组织<br/>收缩，运动的动力来源"]
    T -.-> T4["神经组织<br/>感受刺激·传导兴奋"]

    S -.-> S1["运动系统 · 消化系统 · 呼吸系统"]
    S -.-> S2["泌尿系统 · 生殖系统 · 循环系统"]
    S -.-> S3["内分泌系统 · 感觉器 · 神经系统"]

    classDef lv fill:#f3ede2,stroke:#8a5a2b,stroke-width:1.6px,color:#1f1b16
    classDef det fill:#fbf8f2,stroke:#b9a992,stroke-width:1px,color:#6b6156
    classDef sys fill:#eef2e8,stroke:#4a7c59,stroke-width:1px,color:#1f1b16
    class C,T,O,S,B lv
    class T1,T2,T3,T4 det
    class S1,S2,S3 sys
