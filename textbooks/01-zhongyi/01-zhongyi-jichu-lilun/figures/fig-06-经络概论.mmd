%% 内容依据：textbooks/01-zhongyi/01-zhongyi-jichu-lilun/06-第6章-经络系统.md §5.1
%% 图 6-1 经络的生理功能与临床运用层次
%%   §5.1.1.2 原文「经络具有三大核心功能：沟通联系（联络脏腑器官，沟通表里上下）、
%%     运行气血（输送营养，濡养全身）、感应传导（传递针刺等刺激信号，调节机能平衡）」
%%   §5.4.1.1 原文「十二经别……深入体腔，加强与脏腑的联系；十五别络……加强表里两经在体表的联系」
%%   §5.4.1.2 原文「正经循行有其固定路线，难以覆盖全身所有部位。经别与络脉的广泛分布，弥补了这一不足」
%%   §5.5.1.1「经络辨证主要通过分析经络循行路线的异常（如疼痛、麻木、寒热）及所属脏腑的功能失调来判断病位」
%%   §5.5.1.2「通过观察经络穴位处的阳性反应（压痛、结节、色泽变化）来推断内在脏腑病变」
%%   §5.5.2.1「经脉所过，主治所及」；举胃病取足三里、肺病取太渊
%%   §5.5.2.2「同一区域的穴位具有相似的治疗作用」；头面治神志眼疾、胸腹治脏腑病
%%   临床运用层的小节号见 §5.5（本行出处取 §5.1，即概论与生理功能）。
%% 本章是《中医基础理论》的经络概论，故只画「功能 → 辨治」两层，
%% 不画十二经循行、奇经八脉各论，也不重复组成总图
%% （参见 03-zhenjiu/01-jingluo-xue/figures/fig-01-经络系统的组成.mmd）。
graph TD
    R["经络学说"]

    R --> F["生理功能"]
    R --> U["临床运用"]

    F --> F1["沟通联系<br/>联络脏腑器官<br/>沟通表里上下"]
    F --> F2["运行气血<br/>输送营养<br/>濡养全身"]
    F --> F3["感应传导<br/>传递针刺刺激<br/>调节机能平衡"]

    F1 -. "经别·别络" .-> B["加强表里联系<br/>弥补正经不足"]

    U --> P["经络辨证"]
    P --> D1["循经病候<br/>疼痛·麻木·寒热"]
    P --> D2["阳性反应<br/>压痛·结节·色泽"]

    U --> Z["指导针灸推拿"]
    Z --> Z1["循经取穴<br/>经脉所过<br/>主治所及"]
    Z --> Z2["分部主治<br/>同区穴位<br/>主治相似"]

    Z1 -.-> E1["如胃病取足三里<br/>肺病取太渊"]
    Z2 -.-> E2["头面治神志眼疾<br/>胸腹治脏腑病"]

    classDef root fill:#eef2e8,stroke:#4a7c59,stroke-width:2px,color:#1f1b16
    classDef lv fill:#f3ede2,stroke:#8a5a2b,stroke-width:1.6px,color:#1f1b16
    classDef det fill:#fbf8f2,stroke:#4a7c59,stroke-width:1px,color:#1f1b16
    classDef ex fill:#fbf8f2,stroke:#8a5a2b,stroke-width:1px,color:#1f1b16
    class R root
    class F,U lv
    class F1,F2,F3,D1,D2,Z1,Z2,B det
    class P,Z,E1,E2 ex
