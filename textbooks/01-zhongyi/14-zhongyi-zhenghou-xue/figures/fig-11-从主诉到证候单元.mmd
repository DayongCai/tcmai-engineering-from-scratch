%% 图 11 从一句话主诉到「疾病证候单元」：一条像 CI 的流水线
%% 内容依据：textbooks/01-zhongyi/14-zhongyi-zhenghou-xue/00-凡例与使用.md §5（应用工程手册）
%% 说明：六段与附录 E 的流水线一一对应；失败分支必须如实返回「未收录」，不许模糊匹配。

flowchart TD
  IN["输入：一句主诉<br/>「怕冷、没汗、头身疼」"] --> N1["① 归一 normalize<br/>口语 → 症状词"]
  N1 -->|归一失败| E1["未收录（如实返回）<br/>不猜、不模糊匹配"]
  N1 --> N2["② 定维 dimension<br/>位 locus × 性 nature × 态 state"]
  N2 --> N3["③ 取候选 candidates<br/>位+性≥3 且两侧各≥1"]
  N3 -->|零候选| E2["换相邻位/性再试一次<br/>仍空则未收录"]
  N3 --> N4["④ 调用块 match(ctx)<br/>返回全码 M06-L18-Z12-H042"]
  N4 --> N5{"⑤ 开关组分流"}
  N5 -->|失守/郁/虚/火| R1["调理建议<br/>+ 就医提示"]
  N5 -->|陷逆/脱绝| R2["立即就医<br/>危候=true，禁走调理"]
  R1 --> N6["⑥ 医生复核 + 回写全码<br/>回写进病例库，供下一轮训练"]
  R2 --> N6
  N6 --> OUT["产出：疾病证候单元<br/>（码 + 依据 + 出处印张）"]
