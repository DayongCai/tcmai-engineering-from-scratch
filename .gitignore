# 生成物与临时文件
node_modules/
*.log
.DS_Store
Thumbs.db

# 站点构建缓存
site/.cache/
site/stats.json

# 视频与音频中间产物（成片走 release，不入库）
platform/**/narration/*.mp3
platform/**/narration/*.wav
platform/**/video/*.mp4
platform/**/video/*.webm
# 中间产物：逐帧 PNG（几十 MB）与 TTS 配音（可 13 秒重建）都不入库。
# 成片（video/lesson.mp4）走 release 附件发布，见 platform/README.md。
platform/**/frames/
platform/**/narration/audio/
platform/**/concat.txt
platform/**/tmp/
platform/**/__pycache__/

# 教材排版产物
textbooks/build/
textbooks/**/build/*.pdf
textbooks/**/build/*.epub
textbooks/**/build/*.tex

# 源材料解析产物：content.json 是**纯派生**（15 MB，可由源 xlsx 重跑得到），不入库。
# 入库的是：sources/*.xlsx（不可再生的源数据）+ <标题>.md（人可读全本，交付物）
#            + source-map.json（出处与指纹，小且需长期保存）
# 重建：node scripts/import_materials.js
standards/materials/*/content.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# 编辑器
.vscode/
.idea/
*.code-workspace

# 本地草稿
*.local.md
scratch/
tmp/
site/snapshot/

# 嵌入层派生产物（可由 node scripts/build_embeddings.js 重跑；README.md 入库）
standards/semtensor/embeddings/index.json

# ICD-11 快照与本地库（19.5 MB，版权属 WHO；按 sha256 可重现，见 standards/icd11/README.md）
data/icd11/
