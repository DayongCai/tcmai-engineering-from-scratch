{
 "$about": "态轴语素表 —— 「疾病证候单元」的第三轴（病机状态）。全部 99 个字面态取自本书 1866 条候名的尾部，逐个剥离后无剩余者才收（剥离不掉的记 缺口登记.json）。每个态带：族、一句释义、治法动作、ICD-11 TM1 property 构件。",
 "$source": {
  "来源": "目录原文.txt 的 1866 条候条目；候名尾部的 2 字组合共 99 种，全部在此，无一遗漏、无一臆造。",
  "拆分口径": "候名 = 候位（位轴） + 态（本表） + 「候」。长匹配优先：先匹配 候位表 的最长项，再从剩余尾部匹配最长态（含 3 字态 失宣降 / 竭阳脱）。",
  "统计": "99 态 / 6 族",
  "tm1": "standards/icd11/tm1/axes.json · lexicon.property（50 项）"
 },
 "族": [
  {"id": "失守", "释": "该做的没做到：宣、降、和、运、纳、摄、固、养……一律用「失／不」标出缺位。"},
  {"id": "郁", "释": "该通的没通：气、血、津、火在局部堵住，堵而不得出。是本书出现频率最高的一族。"},
  {"id": "虚", "释": "该有的不足，且不足本身成为病机（不是单纯缺，是「不足而生变」）。"},
  {"id": "火", "释": "热之极且有势头：蒸、灼、炽、燔、亢、逆。区分实火与虚火看候位，不看态。"},
  {"id": "脱绝", "释": "防线破了：闭、脱、厥、竭、越、绝。这一族是危候标志，任何一条出现都要单独提示。"},
  {"id": "陷逆", "释": "方向错了：当升不升（陷）、当降不降（逆、横、乱）。"}
 ],
 "态": [
  {"zh": "失宣", "族": "失守", "释": "应当宣发敷布的（气、卫、营、络）没有宣发出去。", "动作": "宣", "tm1": ["failing"]},
  {"zh": "失宣降", "族": "失守", "释": "宣发与肃降同时失职，气既出不去也降不下。", "动作": "宣降", "tm1": ["failing"]},
  {"zh": "宣降", "族": "失守", "释": "宣降之职失司（候名省「失」字，义同）。", "动作": "宣降", "tm1": ["failing"]},
  {"zh": "清肃", "族": "失守", "释": "肺失清肃之职（候名省「失」字）：气道不清、肃降不行。", "动作": "清肃", "tm1": ["failing"]},
  {"zh": "和降", "族": "失守", "释": "胃失和降（候名省「失」字）：不下行反上逆。", "动作": "和降", "tm1": ["failing"]},
  {"zh": "失和", "族": "失守", "释": "本该协调的两方失于协调（营卫、脾胃、气血、阴阳）。", "动作": "调和", "tm1": ["disharmony"]},
  {"zh": "不和", "族": "失守", "释": "同「失和」，多用于表里、寒热、脏腑之间。", "动作": "调和", "tm1": ["disharmony"]},
  {"zh": "失调", "族": "失守", "释": "调节机制失灵，开合、升降、燥润失去节律。", "动作": "调", "tm1": ["disharmony"]},
  {"zh": "不交", "族": "失守", "释": "该相交的没有相交（心肾不交、水火不交、阴阳不交）。", "动作": "交通", "tm1": ["disharmony"]},
  {"zh": "失运", "族": "失守", "释": "脾失运化：该转输的没有转输。", "动作": "运", "tm1": ["failing"]},
  {"zh": "失纳", "族": "失守", "释": "该受纳、摄纳的没有受纳（胃不纳食、肾不纳气）。", "动作": "纳", "tm1": ["failing"]},
  {"zh": "失摄", "族": "失守", "释": "该统摄的没有统摄（脾不统血、肾不摄精）。", "动作": "摄", "tm1": ["failing"]},
  {"zh": "不摄", "族": "失守", "释": "同「失摄」，多用于气不摄血、气不摄津。", "动作": "摄", "tm1": ["failing"]},
  {"zh": "失固", "族": "失守", "释": "该固守的没有固守（卫外不固、精关不固）。", "动作": "固", "tm1": ["failing"]},
  {"zh": "不固", "族": "失守", "释": "同「失固」，多用于表虚自汗、滑脱不禁。", "动作": "固", "tm1": ["failing"]},
  {"zh": "失养", "族": "失守", "释": "该得到濡养的没有得到（脏腑、筋脉、清窍）。", "动作": "养", "tm1": ["deficiency"]},
  {"zh": "失充", "族": "失守", "释": "该被充养的没有充起来，程度轻于失养。", "动作": "充", "tm1": ["deficiency"]},
  {"zh": "不充", "族": "失守", "释": "同「失充」。", "动作": "充", "tm1": ["deficiency"]},
  {"zh": "失位", "族": "失守", "释": "该在本位的不在本位（清阳失位、虚阳失位）。", "动作": "安位", "tm1": ["unstable"]},
  {"zh": "失宁", "族": "失守", "释": "该安宁的不得安宁（神魂、清气、心神）。", "动作": "宁", "tm1": ["unstable"]},
  {"zh": "不宁", "族": "失守", "释": "同「失宁」，多用于烦躁、惊悸、不安。", "动作": "宁", "tm1": ["unstable"]},
  {"zh": "失醒", "族": "失守", "释": "神识该清醒而不清醒（程度轻于闭脱）。", "动作": "醒神", "tm1": ["spirit"]},
  {"zh": "不醒", "族": "失守", "释": "同「失醒」。", "动作": "醒神", "tm1": ["spirit"]},
  {"zh": "失疏", "族": "失守", "释": "肝失疏泄，气机该疏的不疏。", "动作": "疏", "tm1": ["stagnation"]},
  {"zh": "不行", "族": "失守", "释": "该运行的不运行（营卫不行、气血不行）。", "动作": "行", "tm1": ["stagnation"]},
  {"zh": "不布", "族": "失守", "释": "该敷布的不敷布（津液不布、卫气不布）。", "动作": "布", "tm1": ["stagnation"]},
  {"zh": "不化", "族": "失守", "释": "该气化的没有气化（阳不化气、清阳不化）。", "动作": "化", "tm1": ["failing"]},
  {"zh": "不藏", "族": "失守", "释": "该封藏的没有封藏（肝不藏血、肾不藏精）。", "动作": "藏", "tm1": ["failing"]},
  {"zh": "不振", "族": "失守", "释": "该振奋的没有振奋（阳不振、气不振），偏于「提不起劲」。", "动作": "振", "tm1": ["deficiency"]},
  {"zh": "不健", "族": "失守", "释": "脾不健运的简称。", "动作": "健", "tm1": ["deficiency"]},
  {"zh": "不升", "族": "陷逆", "释": "当升不升（清阳不升、气不升）。", "动作": "升", "tm1": ["sinking"]},

  {"zh": "郁滞", "族": "郁", "释": "堵住了且停着不走：以「滞」为主，胀闷而不痛。", "动作": "行", "tm1": ["stagnation"]},
  {"zh": "郁结", "族": "郁", "释": "堵住且结成块：比郁滞更实，可触及。", "动作": "散结", "tm1": ["accumulation"]},
  {"zh": "郁闭", "族": "郁", "释": "堵到密闭：气机完全不通，可见昏、厥、无汗。", "动作": "开闭", "tm1": ["block"]},
  {"zh": "郁遏", "族": "郁", "释": "被压住而伸展不开：阳气被郁，欲出不能。", "动作": "透", "tm1": ["stagnation"]},
  {"zh": "郁蒸", "族": "郁", "释": "堵住又有热在里头蒸：湿热交蒸的典型字面。", "动作": "清透", "tm1": ["turbid"]},
  {"zh": "蕴蒸", "族": "郁", "释": "邪蕴于内而蒸腾于外，义近郁蒸，偏于「蕴积日久」。", "动作": "清透", "tm1": ["turbid"]},
  {"zh": "郁炽", "族": "郁", "释": "郁而化火，火势炽盛。", "动作": "清解", "tm1": ["hyperactivity"]},
  {"zh": "郁逆", "族": "郁", "释": "郁而向上冲逆。", "动作": "降逆", "tm1": ["ascendant"]},
  {"zh": "郁陷", "族": "郁", "释": "郁而向下陷，气既不通又下坠。", "动作": "升提", "tm1": ["sinking"]},
  {"zh": "郁痹", "族": "郁", "释": "郁而闭塞不通，多用于胸痹、络痹。", "动作": "通痹", "tm1": ["impediment"]},
  {"zh": "怫郁", "族": "郁", "释": "气在皮下郁而不畅，烦闷不舒（《素问》「怫郁」之义）。", "动作": "透达", "tm1": ["depression"]},
  {"zh": "阳郁", "族": "郁", "释": "阳气被郁（不是阳虚），热在里而外反不温。", "动作": "达阳", "tm1": ["yang"]},
  {"zh": "瘀结", "族": "郁", "释": "血瘀结聚成块。", "动作": "化瘀散结", "tm1": ["stasis"]},
  {"zh": "燥结", "族": "郁", "释": "燥而结：津枯便结，或燥邪结于局部。", "动作": "润下", "tm1": ["retention"]},
  {"zh": "蒸闭", "族": "郁", "释": "湿热蒸腾而兼闭阻清窍。", "动作": "开窍清透", "tm1": ["block"]},
  {"zh": "蕴闭", "族": "郁", "释": "邪蕴于内而闭阻。", "动作": "开闭", "tm1": ["block"]},
  {"zh": "炽闭", "族": "郁", "释": "火炽而闭：热极反见闭塞。", "动作": "清热开闭", "tm1": ["block"]},
  {"zh": "陷闭", "族": "郁", "释": "气陷而兼闭阻。", "动作": "升提开闭", "tm1": ["block"]},
  {"zh": "窒闭", "族": "郁", "释": "窒塞不通，多用于胸中、气道。", "动作": "通", "tm1": ["block"]},
  {"zh": "闭塞", "族": "郁", "释": "完全不通（清窍闭塞、脉络闭塞）。", "动作": "通开", "tm1": ["obstruction"]},
  {"zh": "蒙闭", "族": "郁", "释": "痰浊蒙蔽清窍：神识昏蒙为主。", "动作": "开窍", "tm1": ["obstructing"]},
  {"zh": "闭厥", "族": "脱绝", "释": "闭而致厥：气机闭阻、神识昏厥，属危候但性质是「实闭」。", "动作": "开闭回厥", "tm1": ["collapse"]},

  {"zh": "虚郁", "族": "虚", "释": "因虚而郁：气不足，推不动，于是郁。治郁必兼补。", "动作": "补而行", "tm1": ["deficiency"]},
  {"zh": "虚滞", "族": "虚", "释": "因虚而滞：与虚郁近义，偏于「停住」。", "动作": "补而行", "tm1": ["deficiency"]},
  {"zh": "虚蒸", "族": "虚", "释": "虚而蒸热：阴虚内热之轻者。", "动作": "滋养", "tm1": ["deficiency"]},
  {"zh": "虚逆", "族": "虚", "释": "虚而上逆：气不足却反上冲。", "动作": "补而降", "tm1": ["deficiency"]},
  {"zh": "虚燥", "族": "虚", "释": "因虚而燥：津血不足所生之燥。", "动作": "滋润", "tm1": ["deficiency"]},
  {"zh": "虚炽", "族": "虚", "释": "虚火炽盛：热象明显而本质是虚。", "动作": "滋阴降火", "tm1": ["deficiency"]},
  {"zh": "虚灼", "族": "虚", "释": "虚而灼热，义近虚炽而程度轻。", "动作": "滋阴清热", "tm1": ["deficiency"]},
  {"zh": "虚闭", "族": "虚", "释": "虚而兼闭（清窍）。", "动作": "补而开", "tm1": ["deficiency"]},
  {"zh": "虚结", "族": "虚", "释": "虚而结：气血不足而结聚。", "动作": "补而散", "tm1": ["deficiency"]},
  {"zh": "虚损", "族": "虚", "释": "虚到有所损（形、神、脏腑）。", "动作": "补虚", "tm1": ["depletion"]},
  {"zh": "虚弱", "族": "虚", "释": "虚而弱，偏于「力不足」。", "动作": "补", "tm1": ["deficiency"]},
  {"zh": "虚脱", "族": "脱绝", "释": "虚极而脱：正气散越，危候。", "动作": "固脱", "tm1": ["collapse"]},
  {"zh": "两虚", "族": "虚", "释": "两方同虚（气阴两虚、阴阳两虚）。", "动作": "双补", "tm1": ["deficiency"]},
  {"zh": "阳弱", "族": "虚", "释": "阳气衰弱，未至虚脱。", "动作": "温阳", "tm1": ["yang"]},
  {"zh": "枯涸", "族": "虚", "释": "阴液枯竭如河床干涸，最重的「干」。", "动作": "大剂滋阴", "tm1": ["depletion"]},

  {"zh": "消灼", "族": "火", "释": "火热在里消耗灼烁津液。", "动作": "清热生津", "tm1": ["consumption"]},
  {"zh": "蒸灼", "族": "火", "释": "蒸腾而灼：湿热蒸、火热灼并见。", "动作": "清透", "tm1": ["hyperactivity"]},
  {"zh": "煎迫", "族": "火", "释": "火热相煎而逼迫（津液、血、神）。", "动作": "清热宁络", "tm1": ["hyperactivity"]},
  {"zh": "燔灼", "族": "火", "释": "火势燔炽灼烈，最重的一档热。", "动作": "泻火", "tm1": ["hyperactivity"]},
  {"zh": "蕴炽", "族": "火", "释": "邪蕴而火炽：热在里而不外扬。", "动作": "清里", "tm1": ["hyperactivity"]},
  {"zh": "蒸炽", "族": "火", "释": "蒸腾而炽盛。", "动作": "清透", "tm1": ["hyperactivity"]},
  {"zh": "火炽", "族": "火", "释": "火势炽盛（候名省主体）。", "动作": "泻火", "tm1": ["hyperactivity"]},
  {"zh": "炽逆", "族": "火", "释": "火炽而上逆。", "动作": "降火", "tm1": ["ascendant"]},
  {"zh": "消涸", "族": "火", "释": "热耗而阴液枯涸。", "动作": "滋阴救液", "tm1": ["depletion"]},
  {"zh": "亢盛", "族": "火", "释": "阳亢而盛（不一定是火，也可指阳亢）。", "动作": "潜阳", "tm1": ["hyperactivity"]},
  {"zh": "亢逆", "族": "火", "释": "亢而上逆（肝阳上亢之逆）。", "动作": "潜降", "tm1": ["ascendant"]},
  {"zh": "升逆", "族": "陷逆", "释": "气升太过而逆。", "动作": "降", "tm1": ["ascendant"]},
  {"zh": "横逆", "族": "陷逆", "释": "该降的不降，反而横向冲犯（肝气横逆犯胃）。", "动作": "平降", "tm1": ["ascendant"]},
  {"zh": "逆乱", "族": "陷逆", "释": "升降之序全乱（气机逆乱）。", "动作": "理气", "tm1": ["unstable"]},
  {"zh": "两燔", "族": "火", "释": "气分与营（血）分的火同时燔炽（气血两燔）。", "action": "", "动作": "气血两清", "tm1": ["hyperactivity"]},
  {"zh": "下陷", "族": "陷逆", "释": "中气下陷：该升的不升，反往下坠。", "动作": "升提", "tm1": ["sinking"]},
  {"zh": "虚陷", "族": "陷逆", "释": "因虚而陷。", "动作": "补而升", "tm1": ["sinking"]},

  {"zh": "闭脱", "族": "脱绝", "释": "闭与脱并见（内闭外脱）：既不通又欲散。", "动作": "开闭固脱", "tm1": ["collapse"]},
  {"zh": "厥脱", "族": "脱绝", "释": "厥而致脱：四肢厥冷、脉微欲绝。", "动作": "回阳固脱", "tm1": ["collapse"]},
  {"zh": "脱绝", "族": "脱绝", "释": "气脱而绝，最重的一档。", "动作": "急救固脱", "tm1": ["collapse"]},
  {"zh": "阳脱", "族": "脱绝", "释": "阳气外脱。", "动作": "回阳", "tm1": ["collapse"]},
  {"zh": "竭绝", "族": "脱绝", "释": "阴或阳竭尽。", "动作": "救逆", "tm1": ["collapse"]},
  {"zh": "阳厥", "族": "脱绝", "释": "阳郁致厥（热深厥深），本质是热。", "动作": "清热达阳", "tm1": ["collapse"]},
  {"zh": "厥逆", "族": "脱绝", "释": "手足逆冷、气机上逆并见。", "action": "", "动作": "回厥降逆", "tm1": ["collapse"]},
  {"zh": "阳越", "族": "脱绝", "释": "阳气上越外浮。", "动作": "潜阳", "tm1": ["unstable"]},
  {"zh": "浮越", "族": "脱绝", "释": "虚阳浮越：热象在上，本质是下焦虚寒。", "动作": "引火归元", "tm1": ["unstable"]},
  {"zh": "阳浮", "族": "脱绝", "释": "阳气上浮不敛。", "动作": "潜敛", "tm1": ["unstable"]},
  {"zh": "归原", "族": "脱绝", "释": "火不归原：火不在命门本位，浮于上。", "动作": "引火归原", "tm1": ["unstable"]},
  {"zh": "归元", "族": "脱绝", "释": "同「归原」（火不归元）。", "动作": "引火归元", "tm1": ["unstable"]},
  {"zh": "及阴", "族": "虚", "释": "阳损及阴：病从阳分蔓延到阴分。", "动作": "阴阳双补", "tm1": ["deficiency"]},
  {"zh": "及阳", "族": "虚", "释": "阴损及阳：病从阴分蔓延到阳分。", "动作": "阴阳双补", "tm1": ["deficiency"]},
  {"zh": "损及阴", "族": "虚", "释": "阳分先损而波及阴分（候名「阳损及阴」的尾部）。", "动作": "阴阳双补", "tm1": ["deficiency"]},
  {"zh": "损及阳", "族": "虚", "释": "阴分先损而波及阳分（候名「阴损及阳」的尾部）。", "动作": "阴阳双补", "tm1": ["deficiency"]},
  {"zh": "不宣", "族": "失守", "释": "该宣通的不宣通（与「失宣」同义，字面取「不」）。", "动作": "宣", "tm1": ["failing"]},
  {"zh": "失清肃", "族": "失守", "释": "肺失清肃之职：气不清、降不行。", "动作": "清肃", "tm1": ["failing"]},
