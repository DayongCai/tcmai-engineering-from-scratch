   "text": "节气阴入与正气相搏"
  },
  {
   "start": 309.82,
   "end": 311.24,
   "text": "节于斜下"
  },
  {
   "start": 311.24,
   "end": 313.38,
   "text": "正邪纷争"
  },
  {
   "start": 313.38,
   "end": 314.64,
   "text": "往来寒热"
  },
  {
   "start": 314.64,
   "end": 315.88,
   "text": "修作有时"
  },
  {
   "start": 315.88,
   "end": 317.82,
   "text": "默默不欲饮食"
  },
  {
   "start": 317.82,
   "end": 320.08,
   "text": "脏腑相连"
  },
  {
   "start": 320.08,
   "end": 321.18,
   "text": "其痛臂下"
  },
  {
   "start": 321.18,
