  },
  {
   "start": 322.34,
   "end": 323.38,
   "text": "故事偶也"
  },
  {
   "start": 323.38,
   "end": 325.2,
   "text": "小柴胡汤煮之"
  },
  {
   "start": 325.2,
   "end": 327.64,
   "text": "扶柴胡汤已"
  },
  {
   "start": 327.64,
   "end": 329.06,
   "text": "可者属阳明"
  },
  {
