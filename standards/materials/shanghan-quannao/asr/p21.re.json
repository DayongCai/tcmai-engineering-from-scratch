 "segments": [
  {
   "start": 0.0,
   "end": 6.96,
   "text": "下面我们来记忆《伤痕论》原文第七十T条"
  },
  {
   "start": 6.96,
   "end": 9.96,
   "text": "本条对应的记忆桩是必闹"
  },
  {
   "start": 9.96,
   "end": 13.14,
   "text": "那它穴位图像取的是谐音"
  },
  {
   "start": 13.14,
   "end": 15.22,
   "text": "闭上一个闹钟,必闹"
  },
  {
   "start": 15.22,
   "end": 18.34,
   "text": "我们来出图记忆"
  },
  {
   "start": 18.34,
   "end": 19.6,
   "text": "第七十七条"
  },
  {
   "start": 19.6,
   "end": 22.6,
   "text": "发汗,若下之而繁热"
  },
  {
   "start": 22.6,
   "end": 25.8,
   "text": "那可以想象汗水流下来"
  },
  {
   "start": 25.8,
   "end": 26.96,
   "text": "砸到这个闹钟"
  },
  {
   "start": 26.96,
   "end": 28.06,
   "text": "发出声响"
  },
  {
   "start": 28.06,
   "end": 30.08,
   "text": "吵得人很烦热"
  },
  {
   "start": 30.08,
   "end": 32.48,
   "text": "那再继续"
  },
  {
   "start": 32.48,
   "end": 34.26,
   "text": "想象烦热这俩字"
  },
  {
   "start": 34.26,
   "end": 36.46,
   "text": "普通掉下来砸到这个人"
  },
  {
   "start": 36.46,
   "end": 38.02,
   "text": "而这个人呢"
  },
  {
   "start": 38.02,
   "end": 38.84,
   "text": "靠在这里"
  },
  {
   "start": 38.84,
   "end": 40.54,
   "text": "捂着心口不舒服"
  },
  {
   "start": 40.54,
   "end": 42.34,
   "text": "就是胸中智者"
  },
  {
   "start": 42.34,
   "end": 44.48,
   "text": "这个时候呢"
  },
  {
   "start": 44.48,
   "end": 46.52,
   "text": "应该用智子齿汤煮汁"
  },
  {
   "start": 46.52,
   "end": 49.32,
   "text": "那大家应该记得"
  },
  {
   "start": 49.32,
   "end": 50.62,
   "text": "上一条里面提到"
  },
  {
   "start": 50.62,
   "end": 53.06,
   "text": "心中傲弄智子齿汤煮汁"
  },
  {
   "start": 53.06,
   "end": 55.12,
   "text": "所以这个胸中智者"
  },
  {
   "start": 55.12,
   "end": 57.16,
   "text": "和心中傲弄差不多"
  },
  {
   "start": 57.16,
   "end": 59.46,
   "text": "都是心胸感受不舒服"
  },
  {
   "start": 59.46,
   "end": 63.26,
   "text": "所以还是用智子齿汤"
  },
  {
   "start": 63.26,
   "end": 66.56,
   "text": "我们来回放一遍"
  },
  {
   "start": 66.56,
   "end": 68.6,
   "text": "第77条"
  },
  {
   "start": 68.6,
   "end": 69.92,
   "text": "发汗"
  },
  {
   "start": 69.92,
   "end": 72.12,
   "text": "若下之而繁热"
  },
  {
   "start": 72.12,
   "end": 73.44,
   "text": "胸中智者"
  },
  {
   "start": 73.44,
   "end": 75.36,
   "text": "智子齿汤煮之"
  },
  {
   "start": 75.36,
   "end": 80.7,
   "text": "下面我们来记忆第78条"
  },
  {
   "start": 80.7,
   "end": 83.54,
   "text": "本条对应的记忆桩是"
  },
  {
   "start": 83.54,
   "end": 84.6,
   "text": "煎鱼"
  },
  {
   "start": 84.6,
   "end": 86.64,
   "text": "我们来出图记忆"
  },
  {
   "start": 86.64,
   "end": 88.78,
   "text": "第七十八条"
  },
  {
   "start": 88.78,
   "end": 90.74,
   "text": "伤寒五六日"
  },
  {
   "start": 90.74,
   "end": 96.76,
   "text": "那可以想象肩膀上扛着个冰块和五六的字样"
  },
  {
   "start": 96.76,
   "end": 99.56,
   "text": "来提示记忆伤寒五六日"
  },
  {
   "start": 99.56,
   "end": 102.88,
   "text": "大夏之后深热不去"
  },
  {
   "start": 102.88,
   "end": 108.5,
   "text": "那我们来用一个向下的箭头符号来表示大夏之后"
  },
  {
   "start": 108.5,
   "end": 113.72,
   "text": "那同时呢你也可以想象这个箭头像个鱼钩似的在钓这条鱼呢"
  },
  {
   "start": 113.72,
   "end": 115.9,
   "text": "而这条鱼呢"
  },
  {
   "start": 115.9,
   "end": 118.28,
   "text": "浑身红彤彤的"
  },
  {
   "start": 118.28,
   "end": 120.02,
   "text": "来提示记忆"
  },
  {
   "start": 120.02,
   "end": 122.1,
   "text": "来提示记忆"
  },
  {
   "start": 122.1,
   "end": 123.56,
   "text": "身热不去"
  },
  {
   "start": 123.56,
   "end": 127.8,
   "text": "心中节痛者"
  },
  {
   "start": 127.8,
   "end": 130.04,
   "text": "那我们可以想象这个鱼啊"
  },
  {
   "start": 130.04,
   "end": 131.98,
   "text": "它心脏这儿节痛"
  },
  {
   "start": 131.98,
   "end": 134.06,
   "text": "胃郁结野"
  },
  {
   "start": 134.06,
   "end": 135.48,
   "text": "质子齿汤煮汁"
  },
  {
   "start": 135.48,
   "end": 137.7,
   "text": "那我们可以把这个"
  },
  {
   "start": 137.7,
   "end": 139.88,
   "text": "质子齿汤的成分"
  },
  {
   "start": 139.88,
   "end": 141.94,
   "text": "质子和豆豉"
  },
  {
   "start": 141.94,
   "end": 144.08,
   "text": "放在这个鱼的尾巴尖上"
  },
  {
   "start": 144.08,
   "end": 145.84,
   "text": "一边挑着质子"
  },
  {
   "start": 145.84,
   "end": 147.24,
   "text": "一边挑着豆豉"
  },
  {
   "start": 147.24,
   "end": 148.98,
   "text": "质子齿汤煮汁"
  },
  {
   "start": 148.98,
   "end": 152.04,
   "text": "我们来回报一遍"
  },
  {
   "start": 152.04,
   "end": 153.58,
   "text": "第78条"
  },
  {
   "start": 153.58,
   "end": 155.42,
   "text": "山寒五六日"
  },
  {
   "start": 155.42,
   "end": 156.74,
   "text": "大夏之后"
  },
  {
   "start": 156.74,
   "end": 158.14,
   "text": "身热不去"
  },
  {
   "start": 158.14,
   "end": 159.84,
   "text": "心中结痛者"
  },
  {
   "start": 159.84,
   "end": 161.2,
   "text": "未欲结也"
  },
  {
   "start": 161.2,
   "end": 163.18,
   "text": "质子齿汤煮汁"
  },
  {
   "start": 163.18,
   "end": 168.74,
   "text": "下面我们来记忆第79条"
  },
  {
   "start": 168.74,
   "end": 171.76,
   "text": "本条对应的记忆桩是"
  },
  {
   "start": 171.76,
   "end": 172.64,
   "text": "巨骨"
  },
  {
   "start": 172.64,
   "end": 174.54,
   "text": "我们来出读记"
  },
  {
   "start": 174.54,
   "end": 176.76,
   "text": "第七十九条"
  },
  {
   "start": 176.76,
   "end": 178.5,
   "text": "伤寒下后"
  },
  {
   "start": 178.5,
   "end": 180.5,
   "text": "那你可以想象下后"
  },
  {
   "start": 180.5,
   "end": 183.28,
   "text": "那你可以想象一个冰块"
  },
  {
   "start": 183.28,
   "end": 185.78,
   "text": "一个大冰块掉到恐龙的尾巴上"
  },
  {
   "start": 185.78,
   "end": 187.48,
   "text": "然后又落下来"
  },
  {
   "start": 187.48,
   "end": 189.44,
   "text": "来提示记"
  },
  {
   "start": 189.44,
   "end": 191.24,
   "text": "伤寒下后"
  },
  {
   "start": 191.24,
   "end": 194.1,
   "text": "心烦腹满"
  },
  {
   "start": 194.1,
   "end": 195.58,
   "text": "那你可以想象"
  },
  {
   "start": 195.58,
   "end": 197.96,
   "text": "这个恐龙尾巴下面这儿站着一个人"
  },
  {
   "start": 197.96,
   "end": 199.98,
   "text": "这个人很心"
  },
  {
   "start": 199.98,
   "end": 200.66,
   "text": "很烦"
  },
  {
   "start": 200.66,
   "end": 202.46,
   "text": "然后富满"
  },
  {
   "start": 202.46,
   "end": 204.52,
   "text": "你可以想象它肚子鼓鼓的"
  },
  {
   "start": 204.52,
   "end": 206.58,
   "text": "代表富满"
  },
  {
   "start": 206.58,
   "end": 209.62,
   "text": "握起不安者"
  },
  {
   "start": 209.62,
   "end": 212.98,
   "text": "那我们来想象它走到这个恐龙脚下"
  },
  {
   "start": 212.98,
   "end": 214.68,
   "text": "握到恐龙脚下"
  },
  {
   "start": 214.68,
   "end": 216.34,
   "text": "一会儿又起来了"
  },
  {
   "start": 216.34,
   "end": 218.16,
   "text": "握起不安"
  },
  {
   "start": 218.16,
   "end": 221.88,
   "text": "质子厚魄汤煮汁"
  },
  {
   "start": 221.88,
   "end": 225.28,
   "text": "那这个呢就是质子齿汤"
  },
  {
   "start": 225.28,
   "end": 227.5,
   "text": "再加上一味厚魄"
  },
  {
   "start": 227.5,
   "end": 232.42,
   "text": "那你可以想象这个厚破树高高的"
  },
  {
   "start": 232.42,
   "end": 235.78,
   "text": "把这个就好像是那个博物馆里面"
  },
  {
   "start": 235.78,
   "end": 237.54,
   "text": "撑恐龙骨架的柱子一样"
  },
  {
   "start": 237.54,
   "end": 239.86,
   "text": "把这恐龙骨架给撑起来了"
  },
  {
   "start": 239.86,
   "end": 241.94,
   "text": "把这恐龙骨架给撑起来了"
  },
  {
   "start": 241.94,
   "end": 245.54,
   "text": "我们来回放一下"
  },
  {
   "start": 245.54,
   "end": 248.6,
   "text": "第79条"
  },
  {
   "start": 248.6,
   "end": 250.54,
   "text": "伤寒下厚"
  },
  {
   "start": 250.54,
   "end": 252.44,
   "text": "心烦富满"
  },
  {
   "start": 252.44,
   "end": 254.22,
   "text": "卧起不安者"
  },
  {
   "start": 254.22,
   "end": 256.66,
   "text": "至子厚破汤煮汁"
  },
  {
   "start": 256.66,
   "end": 261.9,
   "text": "今天的记忆内容就这些"
  },
  {
   "start": 261.9,
   "end": 264.3,
   "text": "大家记得打卡送读哦"
  }
