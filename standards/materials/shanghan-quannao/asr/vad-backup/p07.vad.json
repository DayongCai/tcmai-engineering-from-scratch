 "segments": [
  {
   "start": 3.34,
   "end": 7.06,
   "text": "下面我们来记忆伤寒论原文第十七条"
  },
  {
   "start": 7.06,
   "end": 11.13,
   "text": "本条对应的记忆桩是神雀"
  },
  {
   "start": 11.13,
   "end": 13.12,
   "text": "那续号是十七"
  },
  {
   "start": 13.12,
   "end": 16.6,
   "text": "我们可以把数字十七放在这朵云上面好了"
  },
  {
   "start": 16.6,
   "end": 19.97,
   "text": "本条的内容比较简单"
  },
  {
   "start": 19.97,
   "end": 21.58,
   "text": "若酒客病"
  },
  {
   "start": 21.58,
   "end": 24.78,
   "text": "酒客呢指的就是好饮酒的人"
  },
  {
   "start": 24.78,
   "end": 29.5,
   "text": "那也有的一家说是因为过量饮酒而生病的人"
  },
  {
   "start": 29.5,
   "end": 32.92,
   "text": "那我们就假设这个人是个酒客"
  },
  {
   "start": 32.92,
   "end": 34.84,
   "text": "手里端着一杯酒"
  },
  {
   "start": 34.84,
   "end": 37.6,
   "text": "还喝得醉醺醺的样子"
  },
  {
   "start": 37.6,
   "end": 39.32,
   "text": "不可与桂枝汤"
  },
  {
   "start": 39.32,
   "end": 40.76,
   "text": "得之则藕"
  },
  {
   "start": 40.76,
   "end": 43.92,
   "text": "那就是说酒客表现出了"
  },
  {
   "start": 43.92,
   "end": 45.92,
   "text": "类似桂枝汤症的症状"
  },
  {
   "start": 45.92,
   "end": 47.58,
   "text": "那千万不能"
  },
  {
   "start": 47.58,
   "end": 50.22,
   "text": "当桂枝汤症来治疗"
  },
  {
   "start": 50.22,
   "end": 51.76,
   "text": "不能给他桂枝汤喝"
  },
  {
   "start": 51.76,
   "end": 53.2,
   "text": "喝了会呕吐的"
  },
  {
   "start": 53.2,
   "end": 55.95,
   "text": "那我们想象他喝了一碗"
  },
  {
   "start": 55.95,
   "end": 57.01,
   "text": "桂枝汤之后"
  },
  {
   "start": 57.01,
   "end": 59.39,
   "text": "然后就呕吐在地"
  },
  {
   "start": 59.39,
   "end": 61.33,
   "text": "然后就呕吐在地"
  },
  {
   "start": 61.33,
   "end": 65.08,
   "text": "以九克不喜甘固"
  },
  {
   "start": 65.08,
   "end": 69.68,
   "text": "说是因为九克不喜欢甘味"
  },
  {
   "start": 69.68,
   "end": 74.16,
   "text": "因为桂枝汤里面有制甘草大枣都是甘味的"
  },
  {
   "start": 74.16,
   "end": 76.2,
   "text": "具体大家可以自己看医书"
  },
  {
   "start": 76.2,
   "end": 79.16,
   "text": "我们只需要记住这个甘就行了"
  },
  {
   "start": 79.16,
   "end": 83.64,
   "text": "我们来回放一遍"
  },
  {
   "start": 83.64,
   "end": 84.66,
   "text": "第十七条"
  },
  {
   "start": 84.66,
   "end": 89.54,
   "text": "若九克病不可与桂枝汤得之则藕"
  },
  {
   "start": 89.54,
   "end": 92.14,
   "text": "以九克不喜甘固"
  },
  {
   "start": 92.14,
   "end": 97.08,
   "text": "下面我们来记忆第十八条"
  },
  {
   "start": 97.08,
   "end": 107.9,
   "text": "那这条的意思是说"
  },
  {
   "start": 107.9,
   "end": 110.9,
   "text": "如果素来有哮喘病的人"
  },
  {
   "start": 110.9,
   "end": 113.72,
   "text": "得了太阳病哮喘发作"
  },
  {
   "start": 113.72,
   "end": 116.7,
   "text": "那就可以在桂枝汤里"
  },
  {
   "start": 116.7,
   "end": 119.56,
   "text": "再加上厚破性子人两味药"
  },
  {
   "start": 119.56,
   "end": 121.54,
   "text": "厚破性子人两味药"
  },
  {
   "start": 121.54,
   "end": 124.31,
   "text": "本条对应的记忆桩呢"
  },
  {
   "start": 124.31,
   "end": 125.11,
   "text": "是阴交"
  },
  {
   "start": 125.11,
   "end": 127.73,
   "text": "我们就可以想象"
  },
  {
   "start": 127.73,
   "end": 129.61,
   "text": "这个人就是喘家"
  },
  {
   "start": 129.61,
   "end": 133.05,
   "text": "它正在发作若传家作"
  },
  {
   "start": 133.05,
   "end": 135.61,
   "text": "贵之汤"
  },
  {
   "start": 135.61,
   "end": 138.11,
   "text": "于是给它来一碗贵之汤"
  },
  {
   "start": 138.11,
   "end": 140.57,
   "text": "再加上厚破姓仁"
  },
  {
   "start": 140.57,
   "end": 144.74,
   "text": "厚破是一种树长得又高又笔直的"
  },
  {
   "start": 144.74,
   "end": 146.64,
   "text": "我们来画一个图像辅助记忆"
  },
  {
   "start": 146.64,
   "end": 153.24,
   "text": "再来画一个姓仁帮助记忆"
  },
  {
   "start": 153.24,
   "end": 155.02,
   "text": "我们来回放一遍"
  },
  {
   "start": 155.02,
   "end": 156.22,
   "text": "若传家作"
  },
  {
   "start": 156.22,
   "end": 159.64,
   "text": "贵之汤加厚破姓子仁"
  },
  {
   "start": 159.64,
   "end": 165.84,
   "text": "下面我们来记第十九条"
  },
  {
   "start": 165.84,
   "end": 169.11,
   "text": "第十九条"
  },
  {
   "start": 169.11,
   "end": 171.87,
   "text": "凡吐家服桂枝汤"
  },
  {
   "start": 171.87,
   "end": 174.43,
   "text": "其后必吐浓血也"
  },
  {
   "start": 174.43,
   "end": 176.98,
   "text": "那前面说了"
  },
  {
   "start": 176.98,
   "end": 177.82,
   "text": "酒客"
  },
  {
   "start": 177.82,
   "end": 178.96,
   "text": "喘家"
  },
  {
   "start": 178.96,
   "end": 180.96,
   "text": "这里又说到喘家"
  },
  {
   "start": 180.96,
   "end": 182.8,
   "text": "这里又说到吐家"
  },
  {
   "start": 182.8,
   "end": 185.28,
   "text": "吐家呢就是指肠胃不好"
  },
  {
   "start": 185.28,
   "end": 186.86,
   "text": "经常容易呕吐的人"
  },
  {
   "start": 186.86,
   "end": 190.06,
   "text": "也不适合给他服用桂枝汤"
  },
  {
   "start": 190.06,
   "end": 192.92,
   "text": "因为桂枝的发散力量很强"
  },
  {
   "start": 192.92,
   "end": 195.2,
   "text": "胃力血管会容易破裂胃出血"
  },
  {
   "start": 195.2,
   "end": 197.28,
   "text": "所以说如果服用桂枝汤"
  },
  {
   "start": 197.28,
   "end": 199.12,
   "text": "会吐浓血"
  },
  {
   "start": 199.12,
   "end": 204.02,
   "text": "那我们把条文放到记忆桩图像上来强化记忆"
  },
  {
   "start": 204.02,
   "end": 205.7,
   "text": "这条是"
  },
  {
   "start": 205.7,
   "end": 209.25,
   "text": "本条的记忆桩是汽海"
  },
  {
   "start": 209.25,
   "end": 211.29,
   "text": "那是19条"
  },
  {
   "start": 211.29,
   "end": 213.59,
   "text": "那感兴趣的可以在汽海这边"
  },
  {
   "start": 213.59,
   "end": 215.73,
   "text": "我们来放个数字标记一下"
  },
  {
   "start": 215.73,
   "end": 219.05,
   "text": "想象这个人就是兔家"
  },
  {
   "start": 219.05,
   "end": 220.39,
   "text": "刚刚吐了一摊"
  },
  {
   "start": 220.39,
   "end": 223.17,
   "text": "那他经常容易呕吐"
  },
  {
   "start": 223.17,
   "end": 224.25,
   "text": "胃不好"
  },
  {
   "start": 224.25,
   "end": 225.99,
   "text": "又刚好感冒了"
  },
  {
   "start": 225.99,
   "end": 226.93,
   "text": "浮了桂枝汤"
  },
  {
   "start": 226.93,
   "end": 229.75,
   "text": "结果就吐浓血了"
  },
  {
   "start": 229.75,
   "end": 232.93,
   "text": "那大家可以自己想象"
  },
  {
   "start": 232.93,
   "end": 236.57,
   "text": "它在空中一边飞一边吐浓血"
  },
  {
   "start": 236.57,
   "end": 237.45,
   "text": "吐得到处都是"
  },
  {
   "start": 237.45,
   "end": 242.47,
   "text": "这样记忆就更深刻了"
  },
  {
   "start": 242.47,
   "end": 246.65,
   "text": "好,我们来回放一遍"
  },
  {
   "start": 246.65,
   "end": 249.09,
   "text": "凡吐家福贵之汤"
  },
  {
   "start": 249.09,
   "end": 251.51,
   "text": "其后必吐浓血也"
  },
  {
   "start": 251.51,
   "end": 256.41,
   "text": "那今天我们就记忆这些"
  },
  {
   "start": 256.41,
   "end": 258.57,
   "text": "大家记得打卡送读哦"
  }
 ]
}