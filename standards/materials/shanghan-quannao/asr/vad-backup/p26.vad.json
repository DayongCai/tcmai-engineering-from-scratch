{
 "no": 26,
 "model": "faster-whisper-turbo",
 "beam": 5,
 "audioSec": 308.5,
 "wallSec": 381.2,
 "speed": 0.81,
 "chars": 925,
 "segments": [
  {
   "start": 3.25,
   "end": 7.07,
   "text": "下面我们来记忆沙寒的原文第94条"
  },
  {
   "start": 7.07,
   "end": 10.33,
   "text": "本条对应的记忆桩是气色"
  },
  {
   "start": 10.33,
   "end": 15.12,
   "text": "我们可以一边来简单理解一边出图记忆"
  },
  {
   "start": 15.12,
   "end": 17.59,
   "text": "第94条"
  },
  {
   "start": 17.59,
   "end": 21.87,
   "text": "太阳病未解,卖阴阳俱微"
  },
  {
   "start": 21.87,
   "end": 26.88,
   "text": "我们把文字放在图像的这个位置上"
  },
  {
   "start": 26.88,
   "end": 31.7,
   "text": "太阳病未解,就是说有表证"
  },
  {
   "start": 31.7,
   "end": 35.24,
   "text": "但是之前开了发表的药吃了"
  },
  {
   "start": 35.24,
   "end": 36.74,
   "text": "没有完全去掉"
  },
  {
   "start": 36.74,
   "end": 39.25,
   "text": "所以是太阳病未解"
  },
  {
   "start": 39.25,
   "end": 41.37,
   "text": "脉阴阳俱微"
  },
  {
   "start": 41.37,
   "end": 43.51,
   "text": "我们在前面记过"
  },
  {
   "start": 43.51,
   "end": 45.91,
   "text": "寸脉为阳 齿脉为阴"
  },
  {
   "start": 45.91,
   "end": 48.51,
   "text": "那寸和齿中间是关脉吗"
  },
  {
   "start": 48.51,
   "end": 49.47,
   "text": "寸关齿"
  },
  {
   "start": 49.47,
   "end": 52.58,
   "text": "脉阴阳俱微"
  },
  {
   "start": 52.58,
   "end": 55.84,
   "text": "那就是寸脉和齿脉都比较微弱"
  },
  {
   "start": 55.84,
   "end": 59.61,
   "text": "必先正立汉出而解"
  },
  {
   "start": 59.61,
   "end": 61.55,
   "text": "正立汉出而解"
  },
  {
   "start": 61.55,
   "end": 64.77,
   "text": "那我们可以想象一个小人在这里"
  },
  {
   "start": 64.77,
   "end": 66.67,
   "text": "正立汗出"
  },
  {
   "start": 66.67,
   "end": 73.08,
   "text": "下面呢两句接着有两个蛋字"
  },
  {
   "start": 73.08,
   "end": 76.3,
   "text": "蛋羊脉威者先汗出而解"
  },
  {
   "start": 76.3,
   "end": 79.06,
   "text": "蛋阴脉威者下之而解"
  },
  {
   "start": 79.06,
   "end": 82.57,
   "text": "那这个蛋字是不是很谐音"
  },
  {
   "start": 82.57,
   "end": 84.03,
   "text": "很像鸡蛋的蛋呀"
  },
  {
   "start": 84.03,
   "end": 86.31,
   "text": "那所以我们结合这个场景"
  },
  {
   "start": 86.31,
   "end": 87.37,
   "text": "可以干脆联想"
  },
  {
   "start": 87.37,
   "end": 89.85,
   "text": "这一家三口爸爸手里"
  },
  {
   "start": 89.85,
   "end": 92.21,
   "text": "拿着一个蛋爸爸为羊"
  },
  {
   "start": 92.21,
   "end": 95.57,
   "text": "所以蛋阳脉微者先汗出而解"
  },
  {
   "start": 95.57,
   "end": 97.91,
   "text": "那就是他要想冰好"
  },
  {
   "start": 97.91,
   "end": 100.81,
   "text": "得用发汗的方法出一通汗就好了"
  },
  {
   "start": 100.81,
   "end": 103.26,
   "text": "然后呢"
  },
  {
   "start": 103.26,
   "end": 105.72,
   "text": "蛋阴脉微者下肢而解"
  },
  {
   "start": 105.72,
   "end": 107.32,
   "text": "我们可以联想"
  },
  {
   "start": 107.32,
   "end": 109.96,
   "text": "这个妈妈手里也拿着一个蛋"
  },
  {
   "start": 109.96,
   "end": 110.8,
   "text": "妈妈为阴"
  },
  {
   "start": 110.8,
   "end": 113.64,
   "text": "所以蛋阴脉微者下肢而解"
  },
  {
   "start": 113.64,
   "end": 116.04,
   "text": "就是妈妈要想冰好"
  },
  {
   "start": 116.04,
   "end": 117.06,
   "text": "得用下法"
  },
  {
   "start": 117.06,
   "end": 122.79,
   "text": "若欲下肢"
  },
  {
   "start": 122.79,
   "end": 124.79,
   "text": "以调味成汽汤"
  },
  {
   "start": 124.79,
   "end": 128.52,
   "text": "那怎么样下呢?就是用调味橙汽汤"
  },
  {
   "start": 128.52,
   "end": 131.02,
   "text": "大家还记得橙汽汤的组成"
  },
  {
   "start": 131.02,
   "end": 133.62,
   "text": "大黄,枝干草,芒椒"
  },
  {
   "start": 133.62,
   "end": 137.84,
   "text": "它们是专门抵挡肠胃里的着物造食的"
  },
  {
   "start": 137.84,
   "end": 142.08,
   "text": "好了,我们来整体回放一遍本条"
  },
  {
   "start": 142.08,
   "end": 144.86,
   "text": "第94条"
  },
  {
   "start": 144.86,
   "end": 151.74,
   "text": "太阳病未解,脉阴阳俱危,必先阵力汗出而解"
  },
  {
   "start": 151.74,
   "end": 156.29,
   "text": "但阳脉危者,先汗出而解"
  },
  {
   "start": 156.29,
   "end": 159.81,
   "text": "但阴脉微者下之而解"
  },
  {
   "start": 159.81,
   "end": 165.02,
   "text": "若欲下之,以调味成气汤"
  },
  {
   "start": 165.02,
   "end": 171.58,
   "text": "下面我们来记忆第95条"
  },
  {
   "start": 171.58,
   "end": 175.62,
   "text": "本条对应的记忆桩是缺盆"
  },
  {
   "start": 175.62,
   "end": 177.98,
   "text": "我们来出头记忆"
  },
  {
   "start": 177.98,
   "end": 179.78,
   "text": "第95条"
  },
  {
   "start": 179.78,
   "end": 181.74,
   "text": "第95条"
  },
  {
   "start": 181.74,
   "end": 184.92,
   "text": "太阳病发热汗出者"
  },
  {
   "start": 184.92,
   "end": 188.12,
   "text": "此为荣若未强故使汗出"
  },
  {
   "start": 188.12,
   "end": 190.62,
   "text": "那这里面有两个关键词"
  },
  {
   "start": 190.62,
   "end": 192.6,
   "text": "发热汗出"
  },
  {
   "start": 192.6,
   "end": 195.7,
   "text": "那我们结合这个图像"
  },
  {
   "start": 195.7,
   "end": 197.16,
   "text": "我们来想象一个人"
  },
  {
   "start": 197.16,
   "end": 199.4,
   "text": "就坐在这个盆子里"
  },
  {
   "start": 199.4,
   "end": 201.8,
   "text": "他正发烧发热"
  },
  {
   "start": 201.8,
   "end": 203.84,
   "text": "同时流着汗汗出"
  },
  {
   "start": 203.84,
   "end": 207.53,
   "text": "此为容弱未强"
  },
  {
   "start": 207.53,
   "end": 208.89,
   "text": "那我们怎么联想呢"
  },
  {
   "start": 208.89,
   "end": 211.57,
   "text": "正好这个容是容血"
  },
  {
   "start": 211.57,
   "end": 214.07,
   "text": "那正好这个盆子是红色的"
  },
  {
   "start": 214.07,
   "end": 216.95,
   "text": "那你可以想象这个容很弱"
  },
  {
   "start": 216.95,
   "end": 219.87,
   "text": "指的是胃气"
  },
  {
   "start": 219.87,
   "end": 221.59,
   "text": "那我们可以想象成"
  },
  {
   "start": 221.59,
   "end": 223.19,
   "text": "这个海面上的风浪"
  },
  {
   "start": 223.19,
   "end": 225.04,
   "text": "风浪很强"
  },
  {
   "start": 225.04,
   "end": 226.04,
   "text": "味很强"
  },
  {
   "start": 226.04,
   "end": 230.54,
   "text": "那下一句故事汗出"
  },
  {
   "start": 230.54,
   "end": 233.1,
   "text": "那我们现在纯记的话呢"
  },
  {
   "start": 233.1,
   "end": 236.42,
   "text": "你可以想象这个柔弱的这个蓉"
  },
  {
   "start": 236.42,
   "end": 239.98,
   "text": "这个盆子在风浪很强的海面上飘摇"
  },
  {
   "start": 239.98,
   "end": 242.12,
   "text": "很强的海面上飘摇"
  },
  {
   "start": 242.12,
   "end": 243.98,
   "text": "容若味强"
  },
  {
   "start": 243.98,
   "end": 245.66,
   "text": "能不吓得流汗吗"
  },
  {
   "start": 245.66,
   "end": 250.9,
   "text": "欲救邪风者一贵之汤"
  },
  {
   "start": 250.9,
   "end": 253.38,
   "text": "那我们来想象"
  },
  {
   "start": 253.38,
   "end": 256.58,
   "text": "飘来一碗桂枝汤就能救这个邪风了"
  },
  {
   "start": 256.58,
   "end": 260.48,
   "text": "也就是治疗这个太阳中风的病了"
  },
  {
   "start": 260.48,
   "end": 264.35,
   "text": "好了,我们来回放一遍"
  },
  {
   "start": 264.35,
   "end": 267.02,
   "text": "第95条"
  },
  {
   "start": 267.02,
   "end": 270.7,
   "text": "太阳病,发热汗出者"
  },
  {
   "start": 270.7,
   "end": 274.46,
   "text": "此为荣若未强,故使汗出"
  },
  {
   "start": 274.46,
   "end": 278.61,
   "text": "欲救邪风者,宜桂枝汤"
  },
  {
   "start": 278.61,
   "end": 283.05,
   "text": "今天的记忆内容就这些"
  },
  {
   "start": 283.05,
   "end": 288.05,
   "text": "最近我们记忆的条文内容大都是理论解释"
  },
  {
   "start": 288.43,
   "end": 291.87,
   "text": "那也离不开对条文内容的理解"
  },
  {
   "start": 291.87,
   "end": 292.57,
   "text": "所以呢"
  },
  {
   "start": 292.57,
   "end": 295.67,
   "text": "建议大家在记忆的同时"
  },
  {
   "start": 295.67,
   "end": 299.57,
   "text": "一定要参看一家老师的条文注解"
  },
  {
   "start": 299.57,
   "end": 304.23,
   "text": "来的条文注解来学习辅助记忆"
  },
  {
   "start": 304.23,
   "end": 305.27,
   "text": "好了"
  },
  {
   "start": 305.27,
   "end": 307.23,
   "text": "也要记得打卡送读哦"
  }
 ]
}