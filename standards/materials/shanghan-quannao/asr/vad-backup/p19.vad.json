{
 "no": 19,
 "model": "faster-whisper-turbo",
 "beam": 5,
 "audioSec": 381.5,
 "wallSec": 148.8,
 "speed": 2.56,
 "chars": 1040,
 "segments": [
  {
   "start": 2.93,
   "end": 6.17,
   "text": "下面我们来记忆伤寒冷原文第七十条"
  },
  {
   "start": 6.17,
   "end": 8.87,
   "text": "本条对应的记忆桩是温溜"
  },
  {
   "start": 8.87,
   "end": 11.69,
   "text": "本条的序号是七十"
  },
  {
   "start": 11.69,
   "end": 13.97,
   "text": "那你可以联想这个七零"
  },
  {
   "start": 13.97,
   "end": 15.45,
   "text": "这个零是圆圆的"
  },
  {
   "start": 15.45,
   "end": 17.23,
   "text": "温泉也是圆圆的"
  },
  {
   "start": 17.23,
   "end": 19.94,
   "text": "我们来出读记忆"
  },
  {
   "start": 19.94,
   "end": 21.74,
   "text": "第七十条"
  },
  {
   "start": 21.74,
   "end": 24.47,
   "text": "发汗后误寒者"
  },
  {
   "start": 24.47,
   "end": 27.11,
   "text": "经过发汗这个人误寒"
  },
  {
   "start": 27.11,
   "end": 29.61,
   "text": "想象他冷得裹着毛毯"
  },
  {
   "start": 29.61,
   "end": 32.17,
   "text": "身后好像靠着冰块一样"
  },
  {
   "start": 32.17,
   "end": 33.05,
   "text": "误寒"
  },
  {
   "start": 33.05,
   "end": 36.32,
   "text": "虚故也"
  },
  {
   "start": 36.32,
   "end": 38.12,
   "text": "那我们可以出图"
  },
  {
   "start": 38.12,
   "end": 40.62,
   "text": "这个温泉标上有一块石头"
  },
  {
   "start": 40.62,
   "end": 42.84,
   "text": "上面刻着虚故也"
  },
  {
   "start": 42.84,
   "end": 46.51,
   "text": "不悟寒但热者"
  },
  {
   "start": 46.51,
   "end": 47.31,
   "text": "食也"
  },
  {
   "start": 47.31,
   "end": 49.31,
   "text": "那同样是发汗后"
  },
  {
   "start": 49.31,
   "end": 50.41,
   "text": "但是不饿寒"
  },
  {
   "start": 50.41,
   "end": 52.77,
   "text": "那我们想象他穿一条短裤"
  },
  {
   "start": 52.77,
   "end": 53.41,
   "text": "站在这儿"
  },
  {
   "start": 53.41,
   "end": 54.43,
   "text": "一点都不觉得冷"
  },
  {
   "start": 54.43,
   "end": 55.59,
   "text": "不饿寒"
  },
  {
   "start": 55.59,
   "end": 58.13,
   "text": "而且不但不饿寒"
  },
  {
   "start": 58.13,
   "end": 59.13,
   "text": "还觉得热"
  },
  {
   "start": 59.13,
   "end": 60.03,
   "text": "但热"
  },
  {
   "start": 60.03,
   "end": 61.05,
   "text": "还觉得热"
  },
  {
   "start": 61.05,
   "end": 62.35,
   "text": "但热者"
  },
  {
   "start": 62.35,
   "end": 64.2,
   "text": "食也"
  },
  {
   "start": 64.2,
   "end": 66.78,
   "text": "那就是说因为胃中有东西"
  },
  {
   "start": 66.78,
   "end": 68.5,
   "text": "石灯灯里堵着"
  },
  {
   "start": 68.5,
   "end": 70.74,
   "text": "当合胃气"
  },
  {
   "start": 70.74,
   "end": 74.26,
   "text": "这个时候的治疗方向应当是合胃气"
  },
  {
   "start": 74.26,
   "end": 75.76,
   "text": "具体怎么做呢"
  },
  {
   "start": 75.76,
   "end": 77.46,
   "text": "与调味橙气汤"
  },
  {
   "start": 77.46,
   "end": 79.92,
   "text": "来一碗调味橙气汤"
  },
  {
   "start": 79.92,
   "end": 82.84,
   "text": "那大家还记得橙气汤的组分"
  },
  {
   "start": 82.84,
   "end": 85.0,
   "text": "大黄至甘草盲销"
  },
  {
   "start": 85.0,
   "end": 88.97,
   "text": "我们来回放一遍"
  },
  {
   "start": 88.97,
   "end": 90.51,
   "text": "第七十条"
  },
  {
   "start": 90.51,
   "end": 94.04,
   "text": "发汗后物寒者虚故也"
  },
  {
   "start": 94.04,
   "end": 97.59,
   "text": "不物寒但热者实也"
  },
  {
   "start": 97.59,
   "end": 99.17,
   "text": "当合胃气"
  },
  {
   "start": 99.17,
   "end": 101.23,
   "text": "与调味成汽汤"
  },
  {
   "start": 101.23,
   "end": 106.6,
   "text": "下面我们来记忆第71条"
  },
  {
   "start": 106.6,
   "end": 110.46,
   "text": "本条对应的记忆桩是夏莲"
  },
  {
   "start": 110.46,
   "end": 113.66,
   "text": "我们来出图记忆"
  },
  {
   "start": 113.66,
   "end": 115.55,
   "text": "第71条"
  },
  {
   "start": 115.55,
   "end": 118.68,
   "text": "太阳病发汗后"
  },
  {
   "start": 118.68,
   "end": 120.68,
   "text": "发汗后"
  },
  {
   "start": 120.68,
   "end": 123.09,
   "text": "大汗出"
  },
  {
   "start": 123.09,
   "end": 128.04,
   "text": "那可以想象汗水哗哗地从这个亭子上流下来"
  },
  {
   "start": 128.04,
   "end": 129.38,
   "text": "大汗出"
  },
  {
   "start": 129.38,
   "end": 131.84,
   "text": "胃中干"
  },
  {
   "start": 131.84,
   "end": 134.2,
   "text": "那我们想象这儿挂着一个胃"
  },
  {
   "start": 134.2,
   "end": 135.56,
   "text": "胃里面很干"
  },
  {
   "start": 135.56,
   "end": 136.52,
   "text": "胃中干"
  },
  {
   "start": 136.52,
   "end": 139.74,
   "text": "烦躁不得眠"
  },
  {
   "start": 139.74,
   "end": 143.4,
   "text": "那想象这个人在亭子里面搭了一个吊床"
  },
  {
   "start": 143.4,
   "end": 144.18,
   "text": "想睡觉"
  },
  {
   "start": 144.18,
   "end": 145.72,
   "text": "想要睡眠"
  },
  {
   "start": 145.72,
   "end": 147.64,
   "text": "但是烦躁的睡不着"
  },
  {
   "start": 147.64,
   "end": 151.14,
   "text": "烦躁不得眠"
  },
  {
   "start": 151.14,
   "end": 152.86,
   "text": "欲得饮水者"
  },
  {
   "start": 152.86,
   "end": 154.28,
   "text": "稍稍余饮之"
  },
  {
   "start": 154.28,
   "end": 155.7,
   "text": "另为其合则欲"
  },
  {
   "start": 155.7,
   "end": 158.18,
   "text": "那你可以想象他想喝水"
  },
  {
   "start": 158.18,
   "end": 159.94,
   "text": "于是爬起来找水喝"
  },
  {
   "start": 159.94,
   "end": 161.88,
   "text": "稍稍余饮之"
  },
  {
   "start": 161.88,
   "end": 163.3,
   "text": "于是端起水杯"
  },
  {
   "start": 163.3,
   "end": 164.82,
   "text": "少少喝一点"
  },
  {
   "start": 164.82,
   "end": 167.86,
   "text": "为其合了就好了"
  },
  {
   "start": 167.86,
   "end": 173.48,
   "text": "那接着若迈伏"
  },
  {
   "start": 173.48,
   "end": 177.32,
   "text": "想象它乘着这个迈伏到亭子上去了"
  },
  {
   "start": 177.32,
   "end": 182.86,
   "text": "小便不利"
  },
  {
   "start": 182.86,
   "end": 185.02,
   "text": "微热消渴者"
  },
  {
   "start": 185.02,
   "end": 187.8,
   "text": "想象它在亭子上"
  },
  {
   "start": 187.8,
   "end": 189.02,
   "text": "亭子这个顶上"
  },
  {
   "start": 189.02,
   "end": 190.82,
   "text": "想小便便不出来"
  },
  {
   "start": 190.82,
   "end": 191.9,
   "text": "小便不利"
  },
  {
   "start": 191.9,
   "end": 193.7,
   "text": "同时呢"
  },
  {
   "start": 193.7,
   "end": 194.34,
   "text": "微热"
  },
  {
   "start": 194.34,
   "end": 195.68,
   "text": "微微的发烧"
  },
  {
   "start": 195.68,
   "end": 197.76,
   "text": "消渴"
  },
  {
   "start": 197.76,
   "end": 200.14,
   "text": "意思就是喝再多的水也不解渴"
  },
  {
   "start": 200.14,
   "end": 201.44,
   "text": "我们来想象它"
  },
  {
   "start": 201.44,
   "end": 202.84,
   "text": "拿了一个吸管"
  },
  {
   "start": 202.84,
   "end": 206.62,
   "text": "直接去吸这个旁边水池里的水"
  },
  {
   "start": 206.62,
   "end": 208.48,
   "text": "喝水去了"
  },
  {
   "start": 208.48,
   "end": 209.7,
   "text": "还是不解渴"
  },
  {
   "start": 209.7,
   "end": 214.53,
   "text": "五灵散组织"
  },
  {
   "start": 214.53,
   "end": 216.94,
   "text": "五灵谐音五个铃铛"
  },
  {
   "start": 216.94,
   "end": 219.36,
   "text": "那我们想象在水池边的树上"
  },
  {
   "start": 219.36,
   "end": 220.78,
   "text": "挂着五个铃铛好了"
  },
  {
   "start": 220.78,
   "end": 228.4,
   "text": "下面我们来借助联想出图"
  },
  {
   "start": 228.4,
   "end": 230.9,
   "text": "记忆一下五灵散的组分"
  },
  {
   "start": 230.9,
   "end": 232.25,
   "text": "猪灵"
  },
  {
   "start": 232.25,
   "end": 235.41,
   "text": "想象一只小猪拱翻了一个铃铛"
  },
  {
   "start": 235.41,
   "end": 237.44,
   "text": "择蟹"
  },
  {
   "start": 237.44,
   "end": 239.74,
   "text": "我们出图为"
  },
  {
   "start": 239.74,
   "end": 241.72,
   "text": "我们出图为"
  },
  {
   "start": 241.72,
   "end": 244.24,
   "text": "湖泽边由水流泻下来"
  },
  {
   "start": 244.24,
   "end": 244.72,
   "text": "泽泻"
  },
  {
   "start": 244.72,
   "end": 247.39,
   "text": "然后是浮灵"
  },
  {
   "start": 247.39,
   "end": 248.71,
   "text": "桂枝"
  },
  {
   "start": 248.71,
   "end": 249.87,
   "text": "白竹"
  },
  {
   "start": 249.87,
   "end": 253.08,
   "text": "那我们可以迅速地用串联机"
  },
  {
   "start": 253.08,
   "end": 254.24,
   "text": "把它们系在一起"
  },
  {
   "start": 254.24,
   "end": 257.53,
   "text": "猪灵跑到了泽泻边"
  },
  {
   "start": 257.53,
   "end": 259.72,
   "text": "泽泻的另外一边"
  },
  {
   "start": 259.72,
   "end": 260.96,
   "text": "扶着一个铃铛"
  },
  {
   "start": 260.96,
   "end": 261.54,
   "text": "浮灵"
  },
  {
   "start": 261.54,
   "end": 264.34,
   "text": "浮灵砸断了桂枝"
  },
  {
   "start": 264.34,
   "end": 267.91,
   "text": "桂枝插到了白竹上"
  },
  {
   "start": 267.91,
   "end": 271.67,
   "text": "好了"
  },
  {
   "start": 271.67,
   "end": 273.77,
   "text": "我们来回放一下第71条"
  },
  {
   "start": 273.77,
   "end": 276.26,
   "text": "第71条"
  },
  {
   "start": 276.26,
   "end": 285.5,
   "text": "太阳病,发汗后,大汗出,胃中肝,烦躁不得眠"
  },
  {
   "start": 285.5,
   "end": 293.9,
   "text": "欲得饮水者,稍稍于饮汁,令胃气何则欲"
  },
  {
   "start": 293.9,
   "end": 306.37,
   "text": "若迈伏,小便不利,微热消渴者,五灵散主治"
  },
  {
   "start": 310.77,
   "end": 313.15,
   "text": "下面我们来记忆第72条"
  },
  {
   "start": 313.15,
   "end": 316.21,
   "text": "本条跟上一条内容差不多"
  },
  {
   "start": 316.21,
   "end": 319.05,
   "text": "正好它们对应的记忆桩也差不多"
  },
  {
   "start": 319.05,
   "end": 320.07,
   "text": "上连"
  },
  {
   "start": 320.07,
   "end": 322.9,
   "text": "我们来出头记忆"
  },
  {
   "start": 322.9,
   "end": 324.02,
   "text": "第72条"
  },
  {
   "start": 324.02,
   "end": 328.97,
   "text": "发汉以麦浮朔凡可者五灵散组织"
  },
  {
   "start": 328.97,
   "end": 331.82,
   "text": "那这跟上一条的区别"
  },
  {
   "start": 331.82,
   "end": 333.72,
   "text": "一是麦浮朔"
  },
  {
   "start": 333.72,
   "end": 336.98,
   "text": "那我们想象跟着它一起浮起来的"
  },
  {
   "start": 336.98,
   "end": 339.08,
   "text": "还有好几个气球"
  },
  {
   "start": 339.08,
   "end": 343.5,
   "text": "浮朔凡可者"
  },
  {
   "start": 343.5,
   "end": 345.54,
   "text": "那它不但渴"
  },
  {
   "start": 345.54,
   "end": 347.74,
   "text": "不但是渴想喝水"
  },
  {
   "start": 347.74,
   "end": 348.96,
   "text": "而且很烦"
  },
  {
   "start": 348.96,
   "end": 352.91,
   "text": "这个时候还是五灵散组织"
  },
  {
   "start": 352.91,
   "end": 357.38,
   "text": "我们来回放一遍"
  },
  {
   "start": 357.38,
   "end": 358.68,
   "text": "第72条"
  },
  {
   "start": 358.68,
   "end": 362.57,
   "text": "发汉语"
  },
  {
   "start": 362.57,
   "end": 364.13,
   "text": "麦福硕"
  },
  {
   "start": 364.13,
   "end": 365.39,
   "text": "烦可者"
  },
  {
   "start": 365.39,
   "end": 367.07,
   "text": "五灵散组织"
  },
  {
   "start": 367.07,
   "end": 372.94,
   "text": "今天的记忆内容就这些"
  },
  {
   "start": 372.94,
   "end": 374.84,
   "text": "大家记得打卡送读"
  },
  {
   "start": 374.84,
   "end": 376.84,
   "text": "并在晚上睡觉前"
  },
  {
   "start": 376.84,
   "end": 379.16,
   "text": "脑中回放图像背一遍哦"
  }
 ]
}