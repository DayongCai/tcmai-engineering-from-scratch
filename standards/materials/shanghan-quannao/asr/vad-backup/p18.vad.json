 "segments": [
  {
   "start": 4.21,
   "end": 7.31,
   "text": "下面我们来记忆伤寒的原文第67条"
  },
  {
   "start": 7.31,
   "end": 10.11,
   "text": "本条对应的记忆桩是河谷"
  },
  {
   "start": 10.11,
   "end": 11.95,
   "text": "我们来出图记忆"
  },
  {
   "start": 11.95,
   "end": 13.9,
   "text": "第67条"
  },
  {
   "start": 13.9,
   "end": 15.38,
   "text": "伤寒"
  },
  {
   "start": 15.38,
   "end": 19.42,
   "text": "想象一个人站在这个山上被风寒所伤"
  },
  {
   "start": 19.42,
   "end": 20.1,
   "text": "伤寒"
  },
  {
   "start": 20.1,
   "end": 22.78,
   "text": "若吐若吓后"
  },
  {
   "start": 22.78,
   "end": 24.94,
   "text": "那你可以想象他呕吐"
  },
  {
   "start": 24.94,
   "end": 28.14,
   "text": "然后或者呢又吓到了这里"
  },
  {
   "start": 28.14,
   "end": 31.88,
   "text": "心下腻满气上冲胸"
  },
  {
   "start": 31.88,
   "end": 36.26,
   "text": "那想象他要走钢丝过这个河谷山谷"
  },
  {
   "start": 36.26,
   "end": 37.98,
   "text": "然后看到这么高"
  },
  {
   "start": 37.98,
   "end": 39.14,
   "text": "不仅心下"
  },
  {
   "start": 39.14,
   "end": 41.08,
   "text": "好像有东西腻满"
  },
  {
   "start": 41.08,
   "end": 44.46,
   "text": "气上冲胸"
  },
  {
   "start": 44.46,
   "end": 45.7,
   "text": "起则头炫"
  },
  {
   "start": 45.7,
   "end": 49.06,
   "text": "那你想象着他非常的害怕"
  },
  {
   "start": 49.06,
   "end": 50.5,
   "text": "爬着过钢丝"
  },
  {
   "start": 50.5,
   "end": 52.84,
   "text": "如果站起来就会头炫"
  },
  {
   "start": 52.84,
   "end": 55.98,
   "text": "脉沉紧"
  },
  {
   "start": 55.98,
   "end": 58.38,
   "text": "此时他的脉沉而紧"
  },
  {
   "start": 58.38,
   "end": 62.8,
   "text": "就像这个紧绷的钢丝一样紧"
  },
  {
   "start": 62.8,
   "end": 66.55,
   "text": "动发汗则动精"
  },
  {
   "start": 66.55,
   "end": 68.74,
   "text": "就是如果发汗"
  },
  {
   "start": 68.74,
   "end": 71.96,
   "text": "那你可以想象汗水一滴滴砸下来"
  },
  {
   "start": 71.96,
   "end": 74.38,
   "text": "重大的汗水会动精"
  },
  {
   "start": 74.38,
   "end": 76.24,
   "text": "想象这个钢丝就是精好了"
  },
  {
   "start": 76.24,
   "end": 79.44,
   "text": "身为阵阵摇者"
  },
  {
   "start": 79.44,
   "end": 83.34,
   "text": "因为动精所以身体阵阵摇晃"
  },
  {
   "start": 83.34,
   "end": 88.14,
   "text": "茯苓贵枝白竹甘草汤煮枝"
  },
  {
   "start": 88.14,
   "end": 92.24,
   "text": "那你可以想象河谷这边的山上"
  },
  {
   "start": 92.24,
   "end": 95.46,
   "text": "一个巨大的广告牌上面写着"
  },
  {
   "start": 95.46,
   "end": 98.08,
   "text": "芙苓桂枝白竹甘草汤吧"
  },
  {
   "start": 98.08,
   "end": 100.92,
   "text": "那这也是著名的"
  },
  {
   "start": 100.92,
   "end": 102.0,
   "text": "林桂竹甘汤"
  },
  {
   "start": 102.0,
   "end": 104.82,
   "text": "我们可以出图来记一下它的组份"
  },
  {
   "start": 104.82,
   "end": 107.2,
   "text": "我们来想象"
  },
  {
   "start": 107.2,
   "end": 109.6,
   "text": "这个广告牌上扶着一个铃铛"
  },
  {
   "start": 109.6,
   "end": 110.4,
   "text": "芙苓"
  },
  {
   "start": 110.4,
   "end": 114.84,
   "text": "芙苓旁边插着一根桂枝"
  },
  {
   "start": 114.84,
   "end": 118.59,
   "text": "然后在这个牌子下面"
  },
  {
   "start": 118.59,
   "end": 120.43,
   "text": "一只小白狗下面"
  },
  {
   "start": 120.43,
   "end": 122.19,
   "text": "一只小白狗"
  },
  {
   "start": 122.19,
   "end": 123.87,
   "text": "靠着这个竹字"
  },
  {
   "start": 123.87,
   "end": 124.93,
   "text": "白竹"
  },
  {
   "start": 124.93,
   "end": 129.97,
   "text": "然后一捆甘草从天而降"
  },
  {
   "start": 129.97,
   "end": 134.29,
   "text": "好了"
  },
  {
   "start": 134.29,
   "end": 135.63,
   "text": "我们来回放一遍"
  },
  {
   "start": 135.63,
   "end": 138.57,
   "text": "第67条"
  },
  {
   "start": 138.57,
   "end": 140.19,
   "text": "伤寒"
  },
  {
   "start": 140.19,
   "end": 142.73,
   "text": "若吐若下后"
  },
  {
   "start": 142.73,
   "end": 144.37,
   "text": "心下腻满"
  },
  {
   "start": 144.37,
   "end": 145.87,
   "text": "气上冲凶"
  },
  {
   "start": 145.87,
   "end": 148.07,
   "text": "起则头炫"
  },
  {
   "start": 148.07,
   "end": 149.77,
   "text": "脉沉紧"
  },
  {
   "start": 149.77,
   "end": 152.52,
   "text": "发汗则动精"
  },
  {
   "start": 152.52,
   "end": 154.78,
   "text": "身为阵阵咬者"
  },
  {
   "start": 154.78,
   "end": 156.6,
   "text": "芙苓贵之"
  },
  {
   "start": 156.6,
   "end": 158.56,
   "text": "白竹甘草汤煮之"
  },
  {
   "start": 158.56,
   "end": 164.6,
   "text": "下面我们来记忆第68条"
  },
  {
   "start": 164.6,
   "end": 168.35,
   "text": "那本条对应的记忆桩是杨西"
  },
  {
   "start": 168.35,
   "end": 171.1,
   "text": "我们来出图记忆"
  },
  {
   "start": 171.1,
   "end": 172.86,
   "text": "第68条"
  },
  {
   "start": 172.86,
   "end": 175.15,
   "text": "发汗并不解"
  },
  {
   "start": 175.15,
   "end": 177.27,
   "text": "那我们想象"
  },
  {
   "start": 177.27,
   "end": 180.01,
   "text": "这个人坐着船漂流到阳溪"
  },
  {
   "start": 180.01,
   "end": 182.15,
   "text": "人坐着船漂流到阳溪"
  },
  {
   "start": 182.15,
   "end": 183.39,
   "text": "发汗"
  },
  {
   "start": 183.39,
   "end": 185.71,
   "text": "这个汗水像雨一样下"
  },
  {
   "start": 185.71,
   "end": 187.86,
   "text": "经过这个发汗"
  },
  {
   "start": 187.86,
   "end": 189.32,
   "text": "但是病还没有好"
  },
  {
   "start": 189.32,
   "end": 190.04,
   "text": "并不解"
  },
  {
   "start": 190.04,
   "end": 192.69,
   "text": "反误寒者"
  },
  {
   "start": 192.69,
   "end": 195.35,
   "text": "反而身上冷得发抖"
  },
  {
   "start": 195.35,
   "end": 195.89,
   "text": "误寒"
  },
  {
   "start": 195.89,
   "end": 200.13,
   "text": "那我们在这儿出图一个大冰块的提示记忆"
  },
  {
   "start": 200.13,
   "end": 200.69,
   "text": "误寒"
  },
  {
   "start": 200.69,
   "end": 203.7,
   "text": "虚故也"
  },
  {
   "start": 203.7,
   "end": 209.64,
   "text": "那想象它漂流遇到一块石头上面刻着虚故也"
  },
  {
   "start": 209.64,
   "end": 213.58,
   "text": "勺药甘草父子汤煮汁"
  },
  {
   "start": 213.58,
   "end": 218.48,
   "text": "那么同样我们想象这个岸边有一个广告牌上面写着"
  },
  {
   "start": 218.48,
   "end": 220.34,
   "text": "勺药甘草父子汤"
  },
  {
   "start": 220.34,
   "end": 225.46,
   "text": "我们来出图记忆一下这个勺药甘草父子汤"
  },
  {
   "start": 225.46,
   "end": 226.36,
   "text": "勺药"
  },
  {
   "start": 226.36,
   "end": 228.08,
   "text": "枝甘草"
  },
  {
   "start": 228.08,
   "end": 229.66,
   "text": "刨父子"
  },
  {
   "start": 229.66,
   "end": 233.21,
   "text": "我们来回放一遍"
  },
  {
   "start": 233.21,
   "end": 235.3,
   "text": "第68条"
  },
  {
   "start": 235.3,
   "end": 246.72,
   "text": "发汗 并不解 反物含者 虚故也 勺药 甘草 腹子汤煮之"
  },
  {
   "start": 246.72,
   "end": 252.73,
   "text": "下面我们来记忆第69条"
  },
  {
   "start": 252.73,
   "end": 255.92,
   "text": "本条对应的记忆桩是天丽"
  },
  {
   "start": 255.92,
   "end": 259.61,
   "text": "我们来丰富一下这个记忆桩图像"
  },
  {
   "start": 259.61,
   "end": 262.37,
   "text": "然后把文字与图像结合在一起"
  },
