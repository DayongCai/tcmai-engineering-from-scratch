  {
   "start": 432.08,
   "end": 434.7,
   "text": "这个代表体内的寒气"
  },
  {
   "start": 434.7,
   "end": 435.96,
   "text": "被驱出去了"
  },
  {
   "start": 435.96,
   "end": 437.1,
   "text": "病要好了"
  },
  {
   "start": 437.1,
   "end": 439.26,
   "text": "寒去欲解也"
  },
  {
   "start": 439.26,
   "end": 444.02,
   "text": "我们来整体回放一下这条"
  },
  {
   "start": 444.02,
   "end": 447.24,
   "text": "伤寒"
  },
  {
   "start": 447.24,
   "end": 449.18,
   "text": "心下有水气"
  },
  {
   "start": 449.18,
   "end": 451.0,
   "text": "咳而微喘"
  },
  {
   "start": 451.0,
   "end": 452.42,
   "text": "发热不咳"
  },
  {
   "start": 452.42,
   "end": 454.26,
   "text": "小青龙汤煮之"
  },
  {
   "start": 454.26,
   "end": 456.4,
   "text": "福汤已可者"
  },
  {
   "start": 456.4,
   "end": 458.56,
   "text": "此寒去欲解也"
  },
  {
   "start": 458.56,
   "end": 464.51,
   "text": "今天的记忆就这些"
  },
  {
   "start": 464.51,
   "end": 467.33,
   "text": "大家一定要记得打卡送读"
  },
  {
   "start": 467.33,
   "end": 472.13,
   "text": "然后晚上睡觉前可以在脑中回放图像来背一遍哦"
  }
 ]
}