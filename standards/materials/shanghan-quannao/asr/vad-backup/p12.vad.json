{
 "no": 12,
 "model": "faster-whisper-turbo",
 "beam": 5,
 "audioSec": 510.0,
 "wallSec": 617.0,
 "speed": 0.83,
 "chars": 1440,
 "segments": [
  {
   "start": 0.56,
   "end": 4.12,
   "text": "下面我们来记忆沙寒的原文第30条。"
  },
  {
   "start": 4.91,
   "end": 15.15,
   "text": "本条对应的记忆桩是集中,那集中的谐音是集中,正好呢本条也是对上一条条文的解释,算是集中整理了吧。"
  },
  {
   "start": 16.29,
   "end": 17.43,
   "text": "我们来分段记忆。"
  },
  {
   "start": 18.82,
   "end": 24.88,
   "text": "第一部分,问曰,正向羊淡,按法致之而增据。"
  },
  {
   "start": 24.88,
   "end": 28.34,
   "text": "羊蛋的意思呢是太阳刚刚升起"
  },
  {
   "start": 28.34,
   "end": 33.62,
   "text": "那在这里呢就是说病人的病症看起来像刚刚得太阳病"
  },
  {
   "start": 33.62,
   "end": 34.9,
   "text": "也就是桂枝汤症"
  },
  {
   "start": 34.9,
   "end": 39.38,
   "text": "所以呢普通的医生可能就按照桂枝汤症来治疗了"
  },
  {
   "start": 39.38,
   "end": 40.76,
   "text": "按法治之"
  },
  {
   "start": 40.76,
   "end": 46.52,
   "text": "结果呢而增据就是说反而病情加重了"
  },
  {
   "start": 46.52,
   "end": 51.36,
   "text": "那这句呢其实对应的就是第29条条文里面的"
  },
  {
   "start": 51.36,
   "end": 55.48,
   "text": "凡与贵之 欲恭其表 此物也得之便觉"
  },
  {
   "start": 55.48,
   "end": 63.67,
   "text": "那下一句呢就是增据的表现"
  },
  {
   "start": 63.67,
   "end": 68.29,
   "text": "绝腻 烟中干 两镜居集而沾语"
  },
  {
   "start": 68.29,
   "end": 73.65,
   "text": "那正好也可以对应到第29条条文里的"
  },
  {
   "start": 73.65,
   "end": 81.48,
   "text": "诗言 夜半手足当温 两脚当身 厚如诗言"
  },
  {
   "start": 81.48,
   "end": 84.5,
   "text": "那这也就是第29条里的"
  },
  {
   "start": 84.5,
   "end": 85.32,
   "text": "上一条里的"
  },
  {
   "start": 85.32,
   "end": 87.04,
   "text": "若绝育足温"
  },
  {
   "start": 87.04,
   "end": 89.78,
   "text": "更做少药甘草汤"
  },
  {
   "start": 89.78,
   "end": 90.9,
   "text": "起脚极深"
  },
  {
   "start": 90.9,
   "end": 93.36,
   "text": "那这里说到夜半"
  },
  {
   "start": 93.36,
   "end": 95.34,
   "text": "因为此时夜阳生"
  },
  {
   "start": 95.34,
   "end": 96.48,
   "text": "夜半阳气环嘛"
  },
  {
   "start": 96.48,
   "end": 98.84,
   "text": "所以人体本身也会在这个时间"
  },
  {
   "start": 98.84,
   "end": 101.14,
   "text": "接受天地阳气"
  },
  {
   "start": 101.14,
   "end": 103.3,
   "text": "那我们来画一个月亮"
  },
  {
   "start": 103.3,
   "end": 105.14,
   "text": "代表时间是夜晚吧"
  },
  {
   "start": 105.14,
   "end": 109.07,
   "text": "何以至此"
  },
  {
   "start": 109.07,
   "end": 110.71,
   "text": "为什么会这样呢"
  },
  {
   "start": 110.71,
   "end": 112.81,
   "text": "为什么按照贵之汤症来治疗"
  },
  {
   "start": 112.81,
   "end": 114.01,
   "text": "反而会增据呢"
  },
  {
   "start": 114.01,
   "end": 116.17,
   "text": "那下面一句就是回答"
  },
  {
   "start": 116.17,
   "end": 134.6,
   "text": "那这句的文字呢"
  },
  {
   "start": 134.6,
   "end": 135.48,
   "text": "其实很顺口"
  },
  {
   "start": 135.48,
   "end": 138.54,
   "text": "我们还是来转化成图像记忆"
  },
  {
   "start": 138.54,
   "end": 143.42,
   "text": "那寸口脉就是寸脉"
  },
  {
   "start": 143.42,
   "end": 144.76,
   "text": "村外怎么样呢"
  },
  {
   "start": 144.76,
   "end": 146.02,
   "text": "福而大"
  },
  {
   "start": 146.02,
   "end": 148.48,
   "text": "然后分别说福和大"
  },
  {
   "start": 148.48,
   "end": 150.33,
   "text": "福为丰"
  },
  {
   "start": 150.33,
   "end": 152.56,
   "text": "大为虚"
  },
  {
   "start": 152.56,
   "end": 157.84,
   "text": "然后呢又具体说丰和虚"
  },
  {
   "start": 157.84,
   "end": 160.24,
   "text": "丰就是中丰"
  },
  {
   "start": 160.24,
   "end": 162.56,
   "text": "丰则生微热"
  },
  {
   "start": 162.56,
   "end": 166.0,
   "text": "微热就是发烧嘛"
  },
  {
   "start": 166.0,
   "end": 168.24,
   "text": "虚是指下虚"
  },
  {
   "start": 168.24,
   "end": 170.44,
   "text": "虚则两进鸾"
  },
  {
   "start": 170.44,
   "end": 174.26,
   "text": "并行像桂枝"
  },
  {
   "start": 174.26,
   "end": 178.12,
   "text": "就是这些症状看起来像桂枝汤症"
  },
  {
   "start": 178.12,
   "end": 184.22,
   "text": "因未加父子参其间"
  },
  {
   "start": 184.22,
   "end": 186.22,
   "text": "增贵令汉出"
  },
  {
   "start": 186.22,
   "end": 187.6,
   "text": "亡阳故也"
  },
  {
   "start": 187.6,
   "end": 190.97,
   "text": "有的版本里面没有这个位子"
  },
  {
   "start": 190.97,
   "end": 192.81,
   "text": "应该是有"
  },
  {
   "start": 192.81,
   "end": 194.23,
   "text": "意思就是说"
  },
  {
   "start": 194.23,
   "end": 196.63,
   "text": "本来应该加父子"
  },
  {
   "start": 196.63,
   "end": 198.69,
   "text": "但是却没有加父子"
  },
  {
   "start": 198.69,
   "end": 200.85,
   "text": "却反而增加贵之的用量"
  },
  {
   "start": 200.85,
   "end": 202.63,
   "text": "结果造成"
  },
  {
   "start": 202.63,
   "end": 204.71,
   "text": "病人汉出过多"
  },
  {
   "start": 204.71,
   "end": 207.1,
   "text": "那出汉过多"
  },
  {
   "start": 207.1,
   "end": 208.36,
   "text": "人就会亡阳"
  },
  {
   "start": 208.36,
   "end": 209.82,
   "text": "因为阴阳一体嘛"
  },
  {
   "start": 209.82,
   "end": 210.94,
   "text": "阴托则阳亡"
  },
  {
   "start": 210.94,
   "end": 215.2,
   "text": "那因为这个第30条本身就是纯理论"
  },
  {
   "start": 215.2,
   "end": 218.28,
   "text": "所以我们不得不一边解释来一边记忆"
  },
  {
   "start": 218.28,
   "end": 219.44,
   "text": "讲的不够好"
  },
  {
   "start": 219.44,
   "end": 223.14,
   "text": "大家可以课后自己去看医书"
  },
  {
   "start": 223.14,
   "end": 225.46,
   "text": "那作为纯记忆的话呢"
  },
  {
   "start": 225.46,
   "end": 232.14,
   "text": "我们也可以通过现在构建的这个页面的图形来帮助记忆"
  },
  {
   "start": 232.14,
   "end": 233.46,
   "text": "那现在呢"
  },
  {
   "start": 233.46,
   "end": 235.24,
   "text": "其实大家就可以点击暂停"
  },
  {
   "start": 235.24,
   "end": 239.02,
   "text": "闭上眼睛感受一下你脑瓶上的这个页面"
  },
  {
   "start": 239.02,
   "end": 240.0,
   "text": "有没有这个页面"
  },
  {
   "start": 240.0,
   "end": 241.0,
   "text": "这个页面"
  },
  {
   "start": 241.0,
   "end": 242.02,
   "text": "有没有这个页面"
  },
  {
   "start": 242.02,
   "end": 244.54,
   "text": "并尝试按照脑瓶上的文字"
  },
  {
   "start": 244.54,
   "end": 245.48,
   "text": "试着来背一遍"
  },
  {
   "start": 245.48,
   "end": 252.04,
   "text": "那这一小段呢"
  },
  {
   "start": 252.04,
   "end": 254.12,
   "text": "我们也可以回忆一下"
  },
  {
   "start": 254.12,
   "end": 255.72,
   "text": "前面学过的第二十条"
  },
  {
   "start": 255.72,
   "end": 257.26,
   "text": "其实说的也是这个事情"
  },
  {
   "start": 257.26,
   "end": 259.04,
   "text": "说第二十条"
  },
  {
   "start": 259.04,
   "end": 260.5,
   "text": "太阳病发汗"
  },
  {
   "start": 260.5,
   "end": 261.56,
   "text": "碎漏不止"
  },
  {
   "start": 261.56,
   "end": 263.48,
   "text": "意思就是出汗过多"
  },
  {
   "start": 263.48,
   "end": 264.42,
   "text": "结果呢"
  },
  {
   "start": 264.42,
   "end": 265.68,
   "text": "其人物风"
  },
  {
   "start": 265.68,
   "end": 266.98,
   "text": "脚便难"
  },
  {
   "start": 266.98,
   "end": 268.6,
   "text": "四肢危急"
  },
  {
   "start": 268.6,
   "end": 269.6,
   "text": "难以屈身"
  },
  {
   "start": 269.6,
   "end": 273.46,
   "text": "那这就是第三十条里说的"
  },
  {
   "start": 273.46,
   "end": 276.4,
   "text": "因胃家父子餐期间"
  },
  {
   "start": 276.4,
   "end": 277.62,
   "text": "所以呢"
  },
  {
   "start": 277.62,
   "end": 280.94,
   "text": "要用桂枝加父子汤煮汁"
  },
  {
   "start": 280.94,
   "end": 283.67,
   "text": "好"
  },
  {
   "start": 283.67,
   "end": 286.19,
   "text": "我们现在再回到第三十条的记忆"
  },
  {
   "start": 286.19,
   "end": 290.08,
   "text": "下面一句就是对亡羊症状的总结"
  },
  {
   "start": 290.08,
   "end": 292.06,
   "text": "咽中肝"
  },
  {
   "start": 292.06,
   "end": 294.68,
   "text": "绝腻咽中肝"
  },
  {
   "start": 294.68,
   "end": 295.36,
   "text": "烦躁"
  },
  {
   "start": 295.36,
   "end": 298.23,
   "text": "羊鸣内节"
  },
  {
   "start": 298.23,
   "end": 300.21,
   "text": "羊鸣内节"
  },
  {
   "start": 300.21,
   "end": 301.43,
   "text": "羊鸣"
  },
  {
   "start": 301.43,
   "end": 303.17,
   "text": "就是左羊鸣胃经"
  },
  {
   "start": 303.17,
   "end": 304.35,
   "text": "首羊鸣大肠经"
  },
  {
   "start": 304.35,
   "end": 305.39,
   "text": "就是胃肠"
  },
  {
   "start": 305.39,
   "end": 310.65,
   "text": "那这里也正好就是在第29条里面说的"
  },
  {
   "start": 310.65,
   "end": 311.59,
   "text": "胃气不和"
  },
  {
   "start": 311.59,
   "end": 313.57,
   "text": "因为今夜流失嘛"
  },
  {
   "start": 313.57,
   "end": 315.79,
   "text": "胃肠里面食物堵着了"
  },
  {
   "start": 315.79,
   "end": 316.61,
   "text": "内劫"
  },
  {
   "start": 316.61,
   "end": 317.93,
   "text": "阳明内劫"
  },
  {
   "start": 317.93,
   "end": 320.11,
   "text": "詹语凡乱"
  },
  {
   "start": 320.11,
   "end": 322.46,
   "text": "人肚子里面有造势"
  },
  {
   "start": 322.46,
   "end": 324.28,
   "text": "就会凡乱说胡话"
  },
  {
   "start": 324.28,
   "end": 328.17,
   "text": "那你给这个时候应该怎么补救呢"
  },
  {
   "start": 328.17,
   "end": 330.59,
   "text": "更饮甘草甘姜汤"
  },
  {
   "start": 330.59,
   "end": 333.05,
   "text": "那大家可以自己出土"
  },
  {
   "start": 333.05,
   "end": 334.09,
   "text": "巩固一下"
  },
  {
   "start": 334.09,
   "end": 335.57,
   "text": "制干草"
  },
  {
   "start": 335.57,
   "end": 336.85,
   "text": "干姜"
  },
  {
   "start": 336.85,
   "end": 341.75,
   "text": "那每一个都大脑中迅速掉出图像来"
  },
  {
   "start": 341.75,
   "end": 344.52,
   "text": "这两位要加在一起能够救羊"
  },
  {
   "start": 344.52,
   "end": 349.84,
   "text": "于是下一句就是夜半阳气环"
  },
  {
   "start": 349.84,
   "end": 352.7,
   "text": "就是喝了干草干姜汤"
  },
  {
   "start": 352.7,
   "end": 355.86,
   "text": "再加上半夜子时一阳升"
  },
  {
   "start": 355.86,
   "end": 357.2,
   "text": "阳气就回来了"
  },
  {
   "start": 357.2,
   "end": 359.4,
   "text": "两足当热"
  },
  {
   "start": 359.4,
   "end": 361.41,
   "text": "两足当热"
  },
  {
   "start": 361.41,
   "end": 364.55,
   "text": "静上微居急"
  },
  {
   "start": 364.55,
   "end": 369.59,
   "text": "那就是还剩下两个小腿有点狙击"
  },
  {
   "start": 369.59,
   "end": 375.52,
   "text": "中雨少要甘草汤"
  },
  {
   "start": 375.52,
   "end": 378.68,
   "text": "少要治甘草"
  },
  {
   "start": 378.68,
   "end": 382.29,
   "text": "而乃净身"
  },
  {
   "start": 382.29,
   "end": 384.72,
   "text": "腿就能够伸展自如了"
  },
  {
   "start": 384.72,
   "end": 390.02,
   "text": "那我们再来看最后一句"
  },
  {
   "start": 390.02,
   "end": 392.48,
   "text": "以成气汤微汤"
  },
  {
   "start": 392.48,
   "end": 394.1,
   "text": "则止其沾雨"
  },
  {
   "start": 394.1,
   "end": 395.44,
   "text": "故知病可遇"
  },
  {
   "start": 395.44,
   "end": 399.04,
   "text": "因为成气汤能够攻下"
  },
  {
   "start": 399.04,
   "end": 400.12,
   "text": "有攻下的作用"
  },
  {
   "start": 400.12,
   "end": 401.88,
   "text": "可以使大便汤屑"
  },
  {
   "start": 401.88,
   "end": 402.98,
   "text": "所以说微汤"
  },
  {
   "start": 402.98,
   "end": 405.46,
   "text": "则指其沾语"
  },
  {
   "start": 405.46,
   "end": 408.04,
   "text": "就是肚子里的造势拉出来了"
  },
  {
   "start": 408.04,
   "end": 409.82,
   "text": "阳明内热清除了"
  },
  {
   "start": 409.82,
   "end": 411.42,
   "text": "人就正常了"
  },
  {
   "start": 411.42,
   "end": 412.84,
   "text": "不沾语了"
  },
  {
   "start": 412.84,
   "end": 414.01,
   "text": "所以呢"
  },
  {
   "start": 414.01,
   "end": 415.57,
   "text": "故之并可遇"
  },
  {
   "start": 415.57,
   "end": 419.8,
   "text": "下面我们来整体"
  },
  {
   "start": 419.8,
   "end": 423.54,
   "text": "下面我们来整体回放一下第三十条"
  },
  {
   "start": 423.54,
   "end": 426.95,
   "text": "第三十条"
  },
  {
   "start": 426.95,
   "end": 429.13,
   "text": "问曰正向阳淡"
  },
  {
   "start": 429.13,
   "end": 431.23,
   "text": "按法之之而增聚"
  },
  {
   "start": 431.23,
   "end": 433.19,
   "text": "觉你烟中干"
  },
  {
   "start": 433.19,
   "end": 435.37,
   "text": "两镜居集而沾语"
  },
  {
   "start": 435.37,
   "end": 438.03,
   "text": "诗言夜半手足当温"
  },
  {
   "start": 438.03,
   "end": 439.41,
   "text": "两脚当身"
  },
  {
   "start": 439.41,
   "end": 441.85,
   "text": "厚如诗言何以之词"
  },
  {
   "start": 441.85,
   "end": 445.52,
   "text": "答曰寸口脉福而大"
  },
  {
   "start": 445.52,
   "end": 446.58,
   "text": "福为丰"
  },
  {
   "start": 446.58,
   "end": 447.9,
   "text": "大为虚"
  },
  {
   "start": 447.9,
   "end": 450.31,
   "text": "丰则声微热"
  },
  {
   "start": 450.31,
   "end": 452.9,
   "text": "虚则两净鸾"
  },
  {
   "start": 452.9,
   "end": 455.63,
   "text": "并行向贵之"
  },
  {
   "start": 455.63,
   "end": 459.24,
   "text": "因魏家父子参其间"
  },
  {
   "start": 459.24,
   "end": 462.34,
   "text": "增贵令汉出"
  },
  {
   "start": 462.34,
   "end": 464.32,
   "text": "亡羊故也"
  },
  {
   "start": 464.32,
   "end": 466.23,
   "text": "绝逆"
  },
  {
   "start": 466.23,
   "end": 467.31,
