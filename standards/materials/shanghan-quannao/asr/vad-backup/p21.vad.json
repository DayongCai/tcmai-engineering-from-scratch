 "segments": [
  {
   "start": 3.34,
   "end": 6.96,
   "text": "下面我们来记忆《伤痕论》原文第七十七条"
  },
  {
   "start": 6.96,
   "end": 9.96,
   "text": "本条对应的记忆桩是必闹"
  },
  {
   "start": 9.96,
   "end": 13.14,
   "text": "那它穴位图像取的是谐音"
  },
  {
   "start": 13.14,
   "end": 15.22,
   "text": "闭上一个闹钟必闹"
  },
  {
   "start": 15.22,
   "end": 17.7,
   "text": "我们来出图记忆"
  },
  {
   "start": 17.7,
   "end": 19.64,
   "text": "第七十七条"
  },
  {
   "start": 19.64,
   "end": 22.62,
   "text": "发汗若下之而繁热"
  },
  {
   "start": 22.62,
   "end": 28.1,
   "text": "那可以想象汗水流下来砸到这个闹钟发出声响"
  },
  {
   "start": 28.1,
   "end": 30.06,
   "text": "吵得人很繁热"
  },
  {
   "start": 31.33,
   "end": 34.25,
   "text": "那再继续想象繁热这俩字"
  },
  {
   "start": 34.25,
   "end": 36.43,
   "text": "噗通掉下来砸到这个人"
  },
  {
   "start": 36.43,
   "end": 38.01,
   "text": "而这个人呢"
  },
  {
   "start": 38.01,
   "end": 40.53,
   "text": "靠在这里捂着心口不舒服"
  },
  {
   "start": 40.53,
   "end": 42.33,
   "text": "就是胸中智者"
  },
  {
   "start": 42.33,
   "end": 44.48,
   "text": "这个时候呢"
  },
  {
   "start": 44.48,
   "end": 46.52,
   "text": "应该用智子齿汤煮汁"
  },
  {
   "start": 46.52,
   "end": 50.61,
   "text": "那大家应该记得上一条里面提到"
  },
  {
   "start": 50.61,
   "end": 53.05,
   "text": "心中傲弄智子齿汤煮汁"
  },
  {
   "start": 53.05,
   "end": 57.15,
   "text": "所以这个胸中智者和心中傲弄差不多"
  },
  {
   "start": 57.15,
   "end": 59.45,
   "text": "都是心胸感受不舒服"
  },
  {
   "start": 59.45,
   "end": 63.25,
   "text": "所以还是用智子齿汤"
  },
  {
   "start": 63.25,
   "end": 66.51,
   "text": "我们来回放一遍"
  },
  {
   "start": 66.51,
   "end": 68.57,
   "text": "第77条"
  },
  {
   "start": 68.57,
   "end": 69.94,
   "text": "发汗"
  },
  {
   "start": 69.94,
   "end": 72.12,
   "text": "若下之而繁热"
  },
  {
   "start": 72.12,
   "end": 73.44,
   "text": "胸中智者"
  },
  {
   "start": 73.44,
   "end": 75.36,
   "text": "智子齿汤煮之"
  },
  {
   "start": 75.36,
   "end": 80.7,
   "text": "下面我们来记忆第78条"
  },
  {
   "start": 80.7,
   "end": 83.55,
   "text": "本条对应的记忆桩是"
  },
  {
   "start": 83.55,
   "end": 84.61,
   "text": "尖鱼"
  },
  {
   "start": 84.61,
   "end": 87.05,
   "text": "我们来出图记忆"
  },
  {
   "start": 87.05,
   "end": 88.79,
   "text": "第78条"
  },
  {
   "start": 88.79,
   "end": 90.75,
   "text": "伤寒五六日"
  },
  {
   "start": 90.75,
   "end": 92.11,
   "text": "那可以想象"
  },
  {
   "start": 92.11,
   "end": 94.51,
   "text": "肩膀上扛着个冰块"
  },
  {
   "start": 94.51,
   "end": 96.77,
   "text": "和五六的字样"
  },
  {
   "start": 96.77,
   "end": 99.43,
   "text": "来提示记忆伤寒五六日"
  },
  {
   "start": 99.43,
   "end": 101.83,
   "text": "大下之后"
  },
  {
   "start": 101.83,
   "end": 102.89,
   "text": "生热不去"
  },
  {
   "start": 102.89,
   "end": 105.99,
   "text": "那我们来用一个向下的箭头符号"
  },
  {
   "start": 105.99,
   "end": 108.51,
   "text": "来表示大下之后"
  },
  {
   "start": 108.51,
   "end": 109.59,
   "text": "那同时呢"
  },
  {
   "start": 109.59,
   "end": 111.17,
   "text": "你也可以想象这个箭头"
  },
  {
   "start": 111.17,
   "end": 113.75,
   "text": "像个鱼钩似的在钓这条鱼呢"
  },
  {
   "start": 113.75,
   "end": 115.9,
   "text": "而这条鱼呢"
  },
  {
   "start": 115.9,
   "end": 118.27,
   "text": "浑身红彤彤的"
  },
  {
   "start": 118.27,
   "end": 120.01,
   "text": "来提示记忆"
  },
  {
   "start": 120.01,
   "end": 122.07,
   "text": "来提示记忆"
  },
  {
   "start": 122.07,
   "end": 123.55,
   "text": "生热不去"
  },
  {
   "start": 123.55,
   "end": 127.78,
   "text": "心中节痛着"
  },
  {
   "start": 127.78,
   "end": 130.04,
   "text": "那我们可以想象这个鱼啊"
  },
  {
   "start": 130.04,
   "end": 131.94,
   "text": "它心脏这儿节痛"
  },
  {
   "start": 131.94,
   "end": 139.88,
   "text": "那我们可以把这个质子齿汤的成分"
  },
  {
   "start": 139.88,
   "end": 144.08,
   "text": "质子和豆豉放在这个鱼的尾巴尖上"
  },
  {
   "start": 144.08,
   "end": 147.24,
   "text": "一边挑着质子,一边挑着豆豉"
  },
  {
   "start": 147.24,
   "end": 148.98,
   "text": "质子齿汤煮汁"
  },
  {
   "start": 148.98,
   "end": 152.0,
   "text": "我们来回方一遍"
  },
  {
   "start": 152.0,
   "end": 153.56,
   "text": "第78条"
  },
  {
   "start": 153.56,
   "end": 156.74,
   "text": "山寒五六日,大夏之后"
  },
  {
   "start": 156.74,
   "end": 159.86,
   "text": "深热不去,心中节痛者"
  },
  {
   "start": 159.86,
   "end": 161.22,
   "text": "未欲结也"
  },
  {
   "start": 161.22,
   "end": 163.18,
   "text": "至子齿汤煮汁"
  },
  {
   "start": 163.18,
   "end": 168.76,
   "text": "下面我们来记忆第79条"
  },
  {
   "start": 168.76,
   "end": 172.6,
   "text": "本条对应的记忆桩是巨骨"
  },
  {
   "start": 172.6,
   "end": 175.03,
   "text": "我们来出头记忆"
  },
  {
   "start": 175.03,
   "end": 176.74,
   "text": "第79条"
  },
  {
   "start": 176.74,
   "end": 178.52,
   "text": "伤寒下后"
  },
  {
   "start": 178.52,
   "end": 180.48,
   "text": "那你可以想象下后"
  },
  {
   "start": 180.48,
   "end": 183.29,
   "text": "那你可以想象一个冰块"
  },
  {
   "start": 183.29,
   "end": 185.77,
   "text": "一个大冰块掉到恐龙的尾巴上"
  },
  {
   "start": 185.77,
   "end": 187.39,
   "text": "然后又落下来"
  },
  {
   "start": 187.39,
   "end": 191.22,
   "text": "来提示记忆伤寒下后"
  },
  {
   "start": 191.22,
   "end": 194.08,
   "text": "心烦腹满"
  },
  {
   "start": 194.08,
   "end": 196.82,
   "text": "那你可以想象这个恐龙尾巴下面"
  },
  {
   "start": 196.82,
   "end": 197.98,
   "text": "这儿站着一个人"
  },
  {
   "start": 197.98,
   "end": 200.66,
   "text": "这个人很心很烦"
  },
  {
   "start": 200.66,
   "end": 202.44,
   "text": "然后富满"
  },
  {
   "start": 202.44,
   "end": 204.52,
   "text": "你可以想象他肚子鼓鼓的"
  },
  {
   "start": 204.52,
   "end": 206.58,
   "text": "代表富满"
  },
  {
   "start": 206.58,
   "end": 209.62,
   "text": "握起不安者"
  },
  {
   "start": 209.62,
   "end": 212.98,
   "text": "那我们来想象他走到这个恐龙脚下"
  },
  {
   "start": 212.98,
   "end": 214.68,
   "text": "握到恐龙脚下"
  },
  {
   "start": 214.68,
   "end": 216.36,
   "text": "一会儿又起来了"
  },
  {
   "start": 216.36,
   "end": 218.16,
   "text": "握起不安"
  },
  {
   "start": 218.16,
   "end": 221.88,
   "text": "质子后破汤煮汁"
  },
  {
   "start": 221.88,
   "end": 225.28,
   "text": "那这个呢就是质子齿汤"
  },
  {
   "start": 225.28,
   "end": 227.48,
   "text": "再加上一位后破"
  },
  {
   "start": 227.48,
   "end": 232.44,
   "text": "那你可以想象这个后破数高高的"
  },
  {
   "start": 232.44,
   "end": 235.78,
   "text": "把这个就好像是那个博物馆里面"
  },
  {
   "start": 235.78,
   "end": 237.54,
   "text": "撑恐龙骨架的柱子一样"
  },
  {
   "start": 237.54,
   "end": 239.86,
   "text": "把这恐龙骨架给撑起来了"
  },
  {
   "start": 239.86,
   "end": 241.94,
   "text": "把这恐龙骨架给撑起来了"
  },
  {
   "start": 241.94,
   "end": 245.52,
   "text": "我们来回放一下"
  },
  {
   "start": 245.52,
   "end": 248.6,
   "text": "第79条"
  },
  {
   "start": 248.6,
   "end": 250.54,
   "text": "伤寒下后"
  },
  {
   "start": 250.54,
   "end": 252.42,
   "text": "心烦腹满"
  },
  {
   "start": 252.42,
   "end": 254.24,
   "text": "卧起不安者"
  },
  {
   "start": 254.24,
   "end": 256.66,
   "text": "质子后破汤煮汁"
  },
  {
   "start": 256.66,
   "end": 261.89,
   "text": "今天的记忆内容就这些"
  },
  {
   "start": 261.89,
