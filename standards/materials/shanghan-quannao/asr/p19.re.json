 "segments": [
  {
   "start": 0.0,
   "end": 6.18,
   "text": "下面我们来记忆伤痕原文第70条"
  },
  {
   "start": 6.18,
   "end": 8.86,
   "text": "本条对应的记忆桩是温溜"
  },
  {
   "start": 8.86,
   "end": 11.62,
   "text": "本条的序号是70"
  },
  {
   "start": 11.62,
   "end": 13.78,
   "text": "那你可以联想这个70"
  },
  {
   "start": 13.78,
   "end": 15.44,
   "text": "这个0是圆圆的"
  },
  {
   "start": 15.44,
   "end": 17.24,
   "text": "温泉也是圆圆的"
  },
  {
   "start": 17.24,
   "end": 19.94,
   "text": "我们来出读记忆"
  },
  {
   "start": 19.94,
   "end": 21.74,
   "text": "第70条"
  },
  {
   "start": 21.74,
   "end": 24.48,
   "text": "发汗后误寒者"
  },
  {
   "start": 24.48,
   "end": 27.1,
   "text": "经过发汗这个人误寒"
  },
  {
   "start": 27.1,
   "end": 29.6,
   "text": "想象他冷得裹着毛毯"
  },
  {
   "start": 29.6,
   "end": 32.2,
   "text": "身后好像靠着冰块一样"
  },
  {
   "start": 32.2,
   "end": 33.06,
   "text": "雾寒"
  },
  {
   "start": 33.06,
   "end": 36.28,
   "text": "虚顾也"
  },
  {
   "start": 36.28,
   "end": 38.1,
   "text": "那我们可以出图"
  },
  {
   "start": 38.1,
   "end": 40.62,
   "text": "这个温泉标上有一块石头"
  },
  {
   "start": 40.62,
   "end": 42.88,
   "text": "上面刻着虚顾也"
  },
  {
   "start": 42.88,
   "end": 46.52,
   "text": "不雾寒但热者"
  },
  {
   "start": 46.52,
   "end": 47.3,
   "text": "食也"
  },
  {
   "start": 47.3,
   "end": 49.3,
   "text": "那同样是发汗后"
  },
  {
   "start": 49.3,
   "end": 50.42,
   "text": "但是不饿寒"
  },
  {
   "start": 50.42,
   "end": 52.78,
   "text": "那我们想象他穿一条短裤"
  },
  {
   "start": 52.78,
   "end": 54.46,
   "text": "站在这儿一点都不觉得冷"
  },
  {
   "start": 54.46,
   "end": 55.58,
   "text": "不饿寒"
  },
  {
   "start": 55.58,
   "end": 59.08,
   "text": "而且不但不饿寒还觉得热"
  },
  {
   "start": 59.08,
   "end": 60.04,
   "text": "但热"
  },
  {
   "start": 60.04,
   "end": 61.0,
   "text": "还觉得热"
  },
  {
   "start": 61.0,
   "end": 62.36,
   "text": "但热者"
  },
  {
   "start": 62.36,
   "end": 64.2,
   "text": "食也"
  },
  {
   "start": 64.2,
   "end": 66.76,
   "text": "那就是说因为胃中有东西"
  },
  {
   "start": 66.76,
   "end": 68.2,
   "text": "食灯灯地堵着"
  },
  {
   "start": 68.2,
   "end": 70.74,
   "text": "当合胃气"
  },
  {
   "start": 70.74,
   "end": 74.28,
   "text": "这个时候的治疗方向应当是合胃气"
  },
  {
   "start": 74.28,
   "end": 75.76,
   "text": "具体怎么做呢"
  },
  {
   "start": 75.76,
   "end": 77.48,
   "text": "与调味成气汤"
  },
  {
   "start": 77.48,
   "end": 79.92,
   "text": "来一碗调味成气汤"
  },
  {
   "start": 79.92,
   "end": 82.84,
   "text": "那大家还记得成气汤的组分"
  },
  {
   "start": 82.84,
   "end": 85.0,
   "text": "大黄至甘草芒消"
  },
  {
   "start": 85.0,
   "end": 88.9,
   "text": "我们来回放一遍"
  },
  {
   "start": 88.9,
   "end": 90.52,
   "text": "第七十条"
  },
  {
   "start": 90.52,
   "end": 94.04,
   "text": "发汗后勿含者虚顾也"
  },
  {
   "start": 94.04,
   "end": 97.58,
   "text": "不勿含但热者食也"
  },
  {
   "start": 97.58,
   "end": 101.28,
   "text": "当合胃气与调味成气汤"
  },
  {
   "start": 101.28,
   "end": 106.62,
   "text": "下面我们来记忆第七十一条"
  },
  {
   "start": 106.62,
   "end": 110.46,
   "text": "本条对应的记忆桩是夏莲"
  },
  {
   "start": 110.46,
   "end": 113.66,
   "text": "我们来出图记忆"
  },
  {
   "start": 113.66,
   "end": 115.5,
   "text": "第七十一条"
  },
  {
   "start": 115.5,
   "end": 118.68,
   "text": "太阳并发汗后"
  },
  {
   "start": 118.68,
   "end": 123.12,
   "text": "大汗出"
  },
  {
   "start": 123.12,
   "end": 128.06,
   "text": "那可以想象汗水哗哗地从这个亭子上流下来"
  },
  {
   "start": 128.06,
   "end": 129.4,
   "text": "大汗出"
  },
  {
   "start": 129.4,
   "end": 131.84,
   "text": "胃中干"
  },
  {
   "start": 131.84,
   "end": 134.2,
   "text": "那我们想象这儿挂着一个胃"
  },
  {
   "start": 134.2,
   "end": 135.56,
   "text": "胃里面很干"
  },
  {
   "start": 135.56,
   "end": 136.54,
   "text": "胃中干"
  },
  {
   "start": 136.54,
   "end": 139.74,
   "text": "烦躁不得眠"
  },
  {
   "start": 139.74,
   "end": 143.4,
   "text": "那想象这个人在亭子里面搭了一个吊床"
  },
  {
   "start": 143.4,
   "end": 144.18,
   "text": "想睡觉"
  },
  {
   "start": 144.18,
   "end": 145.72,
   "text": "想要睡眠"
  },
  {
   "start": 145.72,
   "end": 147.64,
   "text": "但是烦躁地睡不着"
  },
  {
   "start": 147.64,
   "end": 149.4,
   "text": "烦躁不得眠"
  },
  {
   "start": 149.4,
   "end": 152.88,
   "text": "欲得饮水者"
  },
  {
   "start": 152.88,
   "end": 154.3,
   "text": "稍稍余饮之"
  },
  {
   "start": 154.3,
   "end": 155.7,
   "text": "令为其合则欲"
  },
  {
   "start": 155.7,
   "end": 158.18,
   "text": "你可以想象他想喝水"
  },
  {
   "start": 158.18,
   "end": 159.94,
   "text": "于是爬起来找水喝"
  },
  {
   "start": 159.94,
   "end": 161.9,
   "text": "稍稍余饮之"
  },
  {
   "start": 161.9,
   "end": 163.32,
   "text": "于是端起水杯"
  },
  {
   "start": 163.32,
   "end": 164.82,
   "text": "少少喝一点"
  },
  {
   "start": 164.82,
   "end": 167.86,
   "text": "为其合了就好了"
  },
  {
   "start": 167.86,
   "end": 172.26,
   "text": "那接着"
  },
  {
   "start": 172.26,
   "end": 173.48,
   "text": "若麦符"
  },
  {
   "start": 173.48,
   "end": 177.24,
   "text": "想象他乘着麦符到亭子上去了"
  },
  {
   "start": 177.24,
   "end": 187.82,
   "text": "想象它在瓶子上"
  },
  {
   "start": 187.82,
   "end": 189.04,
   "text": "瓶子这个顶上"
  },
  {
   "start": 189.04,
   "end": 190.82,
   "text": "想象小便变不出来"
  },
  {
   "start": 190.82,
   "end": 191.92,
   "text": "小便不利"
  },
  {
   "start": 191.92,
   "end": 193.7,
   "text": "同时呢"
  },
  {
   "start": 193.7,
   "end": 194.34,
   "text": "微热"
  },
  {
   "start": 194.34,
   "end": 195.7,
   "text": "微微的发烧"
  },
  {
   "start": 195.7,
   "end": 197.76,
   "text": "消渴"
  },
  {
   "start": 197.76,
   "end": 200.14,
   "text": "意思就是喝再多的水也不解渴"
  },
  {
   "start": 200.14,
   "end": 201.46,
   "text": "我们来想象它"
  },
  {
   "start": 201.46,
   "end": 202.84,
   "text": "拿了一个吸管"
  },
  {
   "start": 202.84,
   "end": 206.62,
   "text": "直接去吸这个旁边水池里的水"
  },
  {
   "start": 206.62,
   "end": 208.48,
   "text": "喝水去了"
  },
  {
   "start": 208.48,
   "end": 209.7,
   "text": "还是不解渴"
  },
  {
   "start": 209.7,
   "end": 214.54,
   "text": "五灵散组织"
  },
  {
   "start": 214.54,
   "end": 216.96,
   "text": "五灵谐音五个铃铛"
  },
  {
   "start": 216.96,
   "end": 220.8,
   "text": "那我们想象在水池边的树上挂着五个铃铛好了"
  },
  {
   "start": 220.8,
   "end": 228.4,
   "text": "下面我们来借助联想出图"
  },
  {
   "start": 228.4,
   "end": 230.88,
   "text": "记忆一下五灵散的组份"
  },
  {
   "start": 230.88,
   "end": 232.26,
   "text": "猪灵"
  },
  {
   "start": 232.26,
   "end": 235.4,
   "text": "想象一只小猪拱翻了一个铃铛"
  },
  {
   "start": 235.4,
   "end": 237.44,
   "text": "择蟹"
  },
  {
   "start": 237.44,
   "end": 240.06,
   "text": "我们出图为湖"
  },
  {
   "start": 240.06,
   "end": 242.48,
   "text": "我们出图为湖泽边"
  },
  {
   "start": 242.48,
   "end": 244.74,
   "text": "由水流泻下来择蟹"
  },
  {
   "start": 244.74,
   "end": 247.4,
   "text": "然后是浮灵"
  },
  {
   "start": 247.4,
   "end": 248.74,
   "text": "桂枝"
  },
  {
   "start": 248.74,
   "end": 249.88,
   "text": "白竹"
  },
  {
   "start": 249.88,
   "end": 253.18,
   "text": "那我们可以迅速地用串联记忆"
  },
  {
   "start": 253.18,
   "end": 254.24,
   "text": "把它们记在一起"
  },
  {
   "start": 254.24,
   "end": 257.52,
   "text": "猪灵跑到了择蟹边"
  },
  {
   "start": 257.52,
   "end": 259.74,
   "text": "择蟹的另外一边"
  },
  {
   "start": 259.74,
   "end": 260.96,
   "text": "扶着一个铃铛"
  },
  {
   "start": 260.96,
   "end": 261.54,
   "text": "浮灵"
  },
  {
   "start": 261.54,
   "end": 264.34,
   "text": "浮灵砸断了桂枝"
  },
  {
   "start": 264.34,
   "end": 267.98,
   "text": "桂枝插到了白竹上"
  },
  {
   "start": 267.98,
   "end": 273.76,
   "text": "好了,我们来回放一下第71条"
  },
  {
   "start": 273.76,
   "end": 276.28,
   "text": "第71条"
  },
  {
   "start": 276.28,
   "end": 280.68,
   "text": "太阳病,发汗后,大汗出"
  },
  {
   "start": 280.68,
   "end": 282.78,
   "text": "胃中肝"
  },
  {
   "start": 282.78,
   "end": 285.52,
   "text": "烦躁不得眠"
  },
  {
   "start": 285.52,
   "end": 288.34,
   "text": "欲得饮水者"
  },
  {
   "start": 288.34,
   "end": 290.86,
   "text": "稍稍于饮汁"
  },
  {
   "start": 290.86,
   "end": 293.9,
   "text": "令胃气何则欲"
  },
  {
   "start": 293.9,
   "end": 297.88,
   "text": "若迈伏,小便不利"
  },
  {
   "start": 297.88,
   "end": 303.0,
   "text": "微热消可者"
  },
  {
   "start": 303.0,
   "end": 306.42,
   "text": "五菱散主治"
  },
  {
   "start": 306.42,
   "end": 313.18,
   "text": "下面我们来记忆第72条"
  },
  {
   "start": 313.18,
   "end": 316.24,
   "text": "那本条跟上一条内容差不多"
  },
  {
   "start": 316.24,
   "end": 319.08,
   "text": "正好它们对应的记忆桩也差不多"
  },
  {
   "start": 319.08,
   "end": 320.08,
   "text": "上连"
  },
  {
   "start": 320.08,
   "end": 322.58,
   "text": "我们来出图记忆"
  },
  {
   "start": 322.58,
   "end": 323.98,
   "text": "第七十二条"
  },
  {
   "start": 323.98,
   "end": 326.94,
   "text": "发汉以麦浮硕"
  },
  {
   "start": 326.94,
   "end": 328.98,
   "text": "凡渴者五零散组织"
  },
  {
   "start": 328.98,
   "end": 331.82,
   "text": "那这跟上一条的区别"
  },
  {
   "start": 331.82,
   "end": 333.72,
   "text": "一是麦浮硕"
  },
  {
   "start": 333.72,
   "end": 336.96,
   "text": "那我们想象跟着它一起浮起来的"
  },
  {
   "start": 336.96,
   "end": 339.08,
   "text": "还有好几个气球"
  },
  {
   "start": 339.08,
   "end": 340.82,
   "text": "浮硕"
  },
  {
   "start": 340.82,
   "end": 343.52,
   "text": "凡渴者"
  },
  {
   "start": 343.52,
   "end": 347.74,
   "text": "那它不但是渴想喝水"
  },
  {
   "start": 347.74,
   "end": 348.98,
   "text": "而且很凡"
  },
  {
   "start": 348.98,
   "end": 352.94,
   "text": "这个时候还是五零散组织"
  },
  {
   "start": 352.94,
   "end": 357.36,
   "text": "我们来回放一遍"
  },
  {
   "start": 357.36,
   "end": 358.66,
   "text": "第七十二条"
  },
  {
   "start": 358.66,
   "end": 360.66,
   "text": "八十二条"
  },
  {
   "start": 360.66,
   "end": 362.58,
   "text": "发汉语"
  },
  {
   "start": 362.58,
   "end": 364.14,
   "text": "麦福硕"
  },
  {
   "start": 364.14,
   "end": 365.38,
   "text": "凡可者"
  },
  {
   "start": 365.38,
   "end": 367.06,
   "text": "五零散组织"
  },
  {
   "start": 367.06,
   "end": 372.94,
   "text": "今天的记忆内容就这些"
  },
  {
   "start": 372.94,
   "end": 374.84,
   "text": "大家记得打卡送读"
  },
  {
   "start": 374.84,
   "end": 376.86,
   "text": "并在晚上睡觉前"
  },
  {
   "start": 376.86,
   "end": 379.12,
   "text": "脑中回放图像被一遍哦"
  }
