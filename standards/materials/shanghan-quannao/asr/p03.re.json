   "text": "一逆上一日再逆促命期"
  },
  {
   "start": 433.18,
   "end": 435.58,
   "text": "若火熏之"
  },
  {
   "start": 435.58,
   "end": 436.88,
   "text": "可能是做哀咎"
  },
  {
   "start": 436.88,
   "end": 438.12,
   "text": "或者烤火了"
  },
  {
   "start": 438.12,
   "end": 439.36,
   "text": "直接烤火了"
  },
  {
   "start": 439.36,
   "end": 441.06,
   "text": "那因为本来就是温病"
  },
  {
   "start": 441.06,
   "end": 442.5,
   "text": "再用火熏之"
  },
  {
   "start": 442.5,
   "end": 444.74,
   "text": "这个就是制错了方向"
  },
  {
   "start": 444.74,
   "end": 445.94,
   "text": "这就是逆"
  },
  {
   "start": 445.94,
   "end": 448.86,
   "text": "那我们出图这个人再烤火好了"
  },
  {
   "start": 448.86,
   "end": 452.72,
   "text": "一逆上一日再逆促命期"
  },
  {
   "start": 452.72,
   "end": 455.2,
   "text": "那意思就是"
  },
  {
   "start": 455.2,
   "end": 457.32,
   "text": "这个火熏一次"
  },
  {
   "start": 457.32,
   "end": 459.26,
   "text": "还能看几天太阳"
  },
  {
   "start": 459.26,
   "end": 460.5,
   "text": "再火熏"
  },
  {
   "start": 460.5,
   "end": 461.54,
   "text": "错上加错"
  },
  {
   "start": 461.54,
   "end": 464.18,
   "text": "五常鬼就来促命期了"
  },
  {
   "start": 464.18,
   "end": 468.3,
   "text": "我们来回放一下这几句"
  },
  {
   "start": 468.3,
   "end": 471.32,
   "text": "若被下者"
  },
  {
   "start": 471.32,
   "end": 472.2,
   "text": "小便不利"
  },
  {
   "start": 472.2,
   "end": 473.18,
   "text": "直视失搜"
  },
  {
   "start": 473.18,
   "end": 475.18,
   "text": "若被火者"
  },
  {
   "start": 475.18,
   "end": 476.34,
   "text": "微发黄色"
  },
  {
   "start": 476.34,
   "end": 479.7,
   "text": "聚则如精咸"
  },
  {
   "start": 479.7,
   "end": 480.74,
   "text": "时吃重"
  },
  {
   "start": 480.74,
   "end": 483.36,
   "text": "若火熏之"
  },
  {
   "start": 483.36,
   "end": 484.8,
   "text": "一逆上隐日"
  },
  {
   "start": 484.8,
   "end": 486.28,
   "text": "再逆促命期"
  },
  {
   "start": 486.28,
