 "segments": [
  {
   "start": 0.0,
   "end": 7.06,
   "text": "下面我们来记忆伤痕论原文第十七条"
  },
  {
   "start": 7.06,
   "end": 11.12,
   "text": "本条对应的记忆桩是神雀"
  },
  {
   "start": 11.12,
   "end": 13.12,
   "text": "那雀号是十七"
  },
  {
   "start": 13.12,
   "end": 16.66,
   "text": "我们可以把数字十七放在这朵云上面好了"
  },
  {
   "start": 16.66,
   "end": 19.58,
   "text": "本条的内容比较简单"
  },
  {
   "start": 19.58,
   "end": 21.56,
   "text": "若九克病"
  },
  {
   "start": 21.56,
   "end": 24.76,
   "text": "九克呢指的就是好饮酒的人"
  },
  {
   "start": 24.76,
   "end": 29.5,
   "text": "那也有的一家说是因为过量饮酒而生病的人"
  },
  {
   "start": 29.5,
   "end": 32.92,
   "text": "那我们就假设这个人是个酒客"
  },
  {
   "start": 32.92,
   "end": 37.52,
   "text": "手里端着一杯酒还喝得醉醺醺的样子"
  },
  {
   "start": 37.52,
   "end": 40.76,
   "text": "不可与桂枝汤得之则藕"
  },
  {
   "start": 40.76,
   "end": 45.92,
   "text": "那就是说酒客表现出了类似桂枝汤症的症状"
  },
  {
   "start": 45.92,
   "end": 50.2,
   "text": "那千万不能当桂枝汤症来治疗"
  },
  {
   "start": 50.2,
   "end": 51.76,
   "text": "不能给他桂枝汤喝"
  },
  {
   "start": 51.76,
   "end": 53.2,
   "text": "喝了会呕吐的"
  },
  {
   "start": 53.2,
   "end": 57.0,
   "text": "那我们想象他喝了一碗桂枝汤之后"
  },
  {
   "start": 57.0,
   "end": 59.38,
   "text": "然后就呕吐在地"
  },
  {
   "start": 59.38,
   "end": 61.34,
   "text": "然后就呕吐在地"
  },
  {
   "start": 61.34,
   "end": 65.08,
   "text": "以九克不喜甘骨"
  },
  {
   "start": 65.08,
   "end": 69.68,
   "text": "说是因为九克不喜欢甘味"
  },
  {
   "start": 69.68,
   "end": 74.16,
   "text": "因为桂枝汤里面有制甘草大枣都是甘味的"
  },
  {
   "start": 74.16,
   "end": 76.22,
   "text": "具体大家可以自己看医书"
  },
  {
   "start": 76.22,
   "end": 79.16,
   "text": "我们只需要记住这个甘就行了"
  },
  {
   "start": 79.16,
   "end": 83.16,
   "text": "我们来回放一遍"
  },
  {
   "start": 83.16,
   "end": 84.64,
   "text": "第十七条"
  },
  {
   "start": 84.64,
   "end": 87.9,
   "text": "若九克病不可与桂枝汤"
  },
  {
   "start": 87.9,
   "end": 89.56,
   "text": "得之则偶"
  },
  {
   "start": 89.56,
   "end": 92.14,
   "text": "以酒客不喜干顾"
  },
  {
   "start": 92.14,
   "end": 97.12,
   "text": "下面我们来记忆第十八条"
  },
  {
   "start": 97.12,
   "end": 99.34,
   "text": "第十八条"
  },
  {
   "start": 99.34,
   "end": 100.96,
   "text": "若喘家作"
  },
  {
   "start": 100.96,
   "end": 103.5,
   "text": "桂枝汤家后破"
  },
  {
   "start": 103.5,
   "end": 104.74,
   "text": "姓子仁"
  },
  {
   "start": 104.74,
   "end": 107.88,
   "text": "那这条的意思是说"
  },
  {
   "start": 107.88,
   "end": 110.88,
   "text": "如果素来有哮喘病的人"
  },
  {
   "start": 110.88,
   "end": 112.32,
   "text": "得了太阳病"
  },
  {
   "start": 112.32,
   "end": 113.7,
   "text": "哮喘发作"
  },
  {
   "start": 113.7,
   "end": 116.7,
   "text": "那就可以在桂枝汤里"
  },
  {
   "start": 116.7,
   "end": 119.56,
   "text": "再加上厚破性子仁两味药"
  },
  {
   "start": 119.56,
   "end": 121.7,
   "text": "厚破性子仁两味药"
  },
  {
   "start": 121.7,
   "end": 124.34,
   "text": "本条对应的记忆桩呢"
  },
  {
   "start": 124.34,
   "end": 125.1,
   "text": "是阴交"
  },
  {
   "start": 125.1,
   "end": 127.72,
   "text": "我们就可以想象"
  },
  {
   "start": 127.72,
   "end": 129.6,
   "text": "这个人就是传家"
  },
  {
   "start": 129.6,
   "end": 131.38,
   "text": "他正在发作呢"
  },
  {
   "start": 131.38,
   "end": 133.06,
   "text": "若传家作"
  },
  {
   "start": 133.06,
   "end": 135.62,
   "text": "桂枝汤"
  },
  {
   "start": 135.62,
   "end": 138.12,
   "text": "于是呢给他来一碗桂枝汤"
  },
  {
   "start": 138.12,
   "end": 140.58,
   "text": "再加上厚破性仁"
  },
  {
   "start": 140.58,
   "end": 142.66,
   "text": "厚破呢是一种树"
  },
  {
   "start": 142.66,
   "end": 144.7,
   "text": "长得又高又笔直的"
  },
  {
   "start": 144.7,
   "end": 146.6,
   "text": "我们来画一个图像辅助记忆"
  },
  {
   "start": 146.6,
   "end": 149.5,
   "text": "再来画一个姓仁帮助记忆"
  },
  {
   "start": 149.5,
   "end": 155.0,
   "text": "我们来回放一遍"
  },
  {
   "start": 155.0,
   "end": 156.24,
   "text": "若传家作"
  },
  {
   "start": 156.24,
   "end": 159.66,
   "text": "贵之汤家后破姓子仁"
  },
  {
   "start": 159.66,
   "end": 165.86,
   "text": "下面我们来记忆第十九条"
  },
  {
   "start": 165.86,
   "end": 169.08,
   "text": "第十九条"
  },
  {
   "start": 169.08,
   "end": 170.44,
   "text": "凡兔家"
  },
  {
   "start": 170.44,
   "end": 171.86,
   "text": "不贵之汤"
  },
  {
   "start": 171.86,
   "end": 174.4,
   "text": "其后必兔农学也"
  },
  {
   "start": 174.4,
   "end": 177.0,
   "text": "那前面说了"
  },
  {
   "start": 177.0,
   "end": 177.8,
   "text": "九克"
  },
  {
   "start": 177.8,
   "end": 178.94,
   "text": "喘家"
  },
  {
   "start": 178.94,
   "end": 180.98,
   "text": "这里又说到喘家"
  },
  {
   "start": 180.98,
   "end": 182.8,
   "text": "这里又说到兔家"
  },
  {
   "start": 182.8,
   "end": 185.28,
   "text": "兔家呢就是指肠胃不好"
  },
  {
   "start": 185.28,
   "end": 186.86,
   "text": "经常容易呕吐的人"
  },
  {
   "start": 186.86,
   "end": 190.06,
   "text": "也不适合给他服用桂枝汤"
  },
  {
   "start": 190.06,
   "end": 192.92,
   "text": "因为桂枝的发散力量很强"
  },
  {
   "start": 192.92,
   "end": 195.22,
   "text": "胃力血管会容易破裂胃出血"
  },
  {
   "start": 195.22,
   "end": 197.28,
   "text": "所以说如果服用桂枝汤"
  },
  {
   "start": 197.28,
   "end": 199.12,
   "text": "会吐浓血"
  },
  {
   "start": 199.12,
   "end": 203.2,
   "text": "那我们把条文放到记忆桩图像上来"
  },
  {
   "start": 203.2,
   "end": 203.98,
   "text": "强化记忆"
  },
  {
   "start": 203.98,
   "end": 209.26,
   "text": "这条本条的记忆桩是汽海"
  },
  {
   "start": 209.26,
   "end": 211.28,
   "text": "那是19条"
  },
  {
   "start": 211.28,
   "end": 213.6,
   "text": "那感兴趣的可以在汽海这边"
  },
  {
   "start": 213.6,
   "end": 215.74,
   "text": "我们来放个数字标记一下"
  },
  {
   "start": 215.74,
   "end": 219.04,
   "text": "想象这个人就是兔家"
  },
  {
   "start": 219.04,
   "end": 220.38,
   "text": "刚刚吐了一摊"
  },
  {
   "start": 220.38,
   "end": 223.16,
   "text": "那他经常容易呕吐"
  },
  {
   "start": 223.16,
   "end": 224.26,
   "text": "胃不好"
  },
  {
   "start": 224.26,
   "end": 226.0,
   "text": "又刚好感冒了"
  },
  {
   "start": 226.0,
   "end": 226.92,
   "text": "服了桂枝汤"
  },
  {
   "start": 226.92,
   "end": 229.76,
   "text": "结果就吐浓血了"
  },
  {
   "start": 229.76,
   "end": 232.92,
   "text": "那大家可以自己想象"
  },
  {
   "start": 232.92,
   "end": 236.56,
   "text": "它在空中一边飞一边吐浓血"
  },
  {
   "start": 236.56,
   "end": 237.46,
   "text": "吐得到处都是"
  },
  {
   "start": 237.46,
   "end": 242.46,
   "text": "这样记忆就更深刻了"
  },
  {
   "start": 242.46,
   "end": 245.46,
   "text": "好,我们来回放一遍"
  },
  {
   "start": 245.46,
   "end": 249.1,
   "text": "凡吐家福贵之汤"
  },
  {
   "start": 249.1,
   "end": 251.54,
   "text": "其后必吐浓血也"
  },
  {
   "start": 251.54,
   "end": 256.4,
   "text": "那今天我们就记忆这些"
  },
  {
   "start": 256.4,
   "end": 258.56,
   "text": "大家记得打卡送读哦"
  }
 ],
