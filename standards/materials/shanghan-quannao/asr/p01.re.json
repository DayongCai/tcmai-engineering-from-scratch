  {
   "start": 366.1,
   "end": 368.7,
   "text": "因为第一组的内容已经连续诵读"
  },
  {
   "start": 368.7,
   "end": 370.36,
   "text": "强化记忆了三天了"
  },
  {
   "start": 370.36,
   "end": 372.56,
   "text": "就已经能够熟练记忆了"
