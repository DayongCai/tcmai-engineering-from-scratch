   "start": 59.64,
   "end": 61.6,
   "text": "一个发热红通通的"
  },
  {
   "start": 61.6,
   "end": 63.8,
   "text": "一个恶寒裹着一层冰"
  },
  {
   "start": 63.8,
   "end": 66.46,
   "text": "而且说热的多寒的少"
