 "rows": [
  {
   "no": 382,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "问曰，病有霍乱者，何，答曰，呕吐而利，此名霍乱。",
   "fang": [],
   "gong": 77,
   "gongName": "G77 中脘宫（任脉）",
   "xue": "中脘",
   "jing": "任脉",
   "zhuang": "东厢"
  },
  {
   "no": 383,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "问曰，病发热，头痛，身疼，恶寒，吐利者，此属何病，答曰，此名霍乱，霍乱自吐下，又利止，复更发热也。",
   "fang": [],
   "gong": 77,
   "gongName": "G77 中脘宫（任脉）",
   "xue": "中脘",
   "jing": "任脉",
   "zhuang": "南窗"
  },
  {
   "no": 384,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "伤寒，其脉微涩者，本是霍乱，今是伤寒，却四五日，至阴经上，转入阴，必利，本呕，下利者，不可治也，欲似大便，而反失气，仍不利者，此属阳明也，便必鞕，十三日愈，所以然者，经尽故也，下利后，当便鞕，鞕则能食者愈，今反不能食，到后经中，颇能食，复过一经能食，过之一日当愈，不愈者，不属阳明也。",
   "fang": [],
   "gong": 77,
   "gongName": "G77 中脘宫（任脉）",
   "xue": "中脘",
   "jing": "任脉",
   "zhuang": "西壁"
  },
  {
   "no": 385,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "恶寒，脉微而复利，利止，亡血也，四逆加人参汤主之。",
   "fang": [
    "四逆加人参汤"
   ],
   "gong": 77,
   "gongName": "G77 中脘宫（任脉）",
   "xue": "中脘",
   "jing": "任脉",
   "zhuang": "北案"
  },
  {
   "no": 386,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "霍乱，头痛，发热，身疼痛，热多欲饮水者，五苓散主之，寒多不用水者，理中丸主之。",
   "fang": [
    "五苓散",
    "理中丸"
   ],
   "gong": 77,
   "gongName": "G77 中脘宫（任脉）",
   "xue": "中脘",
   "jing": "任脉",
   "zhuang": "中庭"
  },
  {
   "no": 387,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "吐利止，而身痛不休者，当消息和解其外，宜桂枝汤小和之。",
   "fang": [
    "桂枝汤"
   ],
   "gong": 78,
   "gongName": "G78 神阙宫（任脉）",
   "xue": "神阙",
   "jing": "任脉",
   "zhuang": "东厢"
  },
  {
   "no": 388,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "吐利汗出，发热恶寒，四肢拘急，手足厥冷者，四逆汤主之。",
   "fang": [
    "四逆汤"
   ],
   "gong": 78,
   "gongName": "G78 神阙宫（任脉）",
   "xue": "神阙",
   "jing": "任脉",
   "zhuang": "南窗"
  },
  {
   "no": 389,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "既吐且利，小便复利，而大汗出，下利清谷，内寒外热，脉微欲绝者，四逆汤主之。",
   "fang": [
    "四逆汤"
   ],
   "gong": 78,
   "gongName": "G78 神阙宫（任脉）",
   "xue": "神阙",
   "jing": "任脉",
   "zhuang": "西壁"
  },
  {
   "no": 390,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "吐已下断，汗出而厥，四肢拘急不解，脉微欲绝者，通脉四逆加猪胆汤主之。",
   "fang": [
    "通脉四逆加猪胆汤"
   ],
   "gong": 78,
   "gongName": "G78 神阙宫（任脉）",
   "xue": "神阙",
   "jing": "任脉",
   "zhuang": "北案"
  },
  {
   "no": 391,
   "liu": "霍乱",
   "pian": "辨霍乱病脉证并治",
   "text": "吐利发汗，脉平，小烦者，以新虚，不胜谷气故也。",
   "fang": [],
   "gong": 78,
   "gongName": "G78 神阙宫（任脉）",
   "xue": "神阙",
   "jing": "任脉",
   "zhuang": "中庭"
