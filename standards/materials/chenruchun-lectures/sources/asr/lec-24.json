  {
   "start": 130.0,
   "end": 131.52,
   "text": "对吧"
  },
  {
   "start": 131.52,
   "end": 133.1,
   "text": "一份当归"
  },
  {
   "start": 133.1,
   "end": 136.22,
   "text": "当归补气"
  },
  {
   "start": 136.22,
   "end": 140.61,
   "text": "有道理啊"
  },
  {
   "start": 140.61,
   "end": 142.38,
   "text": "非常有道理"
  },
  {
   "start": 142.38,
   "end": 146.24,
   "text": "这就符合我们"
  },
  {
   "start": 146.24,
   "end": 148.92,
   "text": "生意的审理病理"
  },
  {
   "start": 148.92,
   "end": 151.25,
   "text": "补气就身陷"
  },
