  },
  {
   "start": 199.17,
   "end": 200.05,
   "text": "这个我干"
  },
  {
   "start": 200.05,
   "end": 201.25,
   "text": "毫不熟了呢"
  },
  {
   "start": 201.25,
   "end": 203.36,
   "text": "补气深陷"
  },
  {
   "start": 203.36,
   "end": 207.33,
   "text": "修行这些行"
  },
  {
   "start": 207.33,
   "end": 210.8,
   "text": "所以这个东西"
  },
  {
   "start": 210.8,
   "end": 213.22,
   "text": "我们说你不能跟到人家跑"
  },
  {
   "start": 213.22,
   "end": 215.14,
   "text": "我记得文化革命后期"
  },
  {
   "start": 215.14,
   "end": 216.84,
   "text": "北京西医院医院"
