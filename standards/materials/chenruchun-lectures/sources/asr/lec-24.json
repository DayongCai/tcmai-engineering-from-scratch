   "start": 225.92,
   "end": 227.96,
   "text": "反正关心病就佛学法医"
  },
  {
   "start": 227.96,
   "end": 229.76,
   "text": "有的人发到就起不来了"
  },
  {
   "start": 229.76,
   "end": 231.78,
   "text": "那个时候我就"
