# 统一按 LF 入库，避免 Windows 上的 CRLF 噪声污染 diff
* text=auto eol=lf

# 二进制/生成物不做行尾转换
*.png binary
*.jpg binary
*.mp4 binary
*.mp3 binary
*.woff2 binary

# 生成物在 diff 里默认折叠（review 时不必逐行看）
catalog.json          linguist-generated=true
ROADMAP.md            linguist-generated=true
site/data.js          linguist-generated=true
site/content.js       linguist-generated=true
site/manifest.json    linguist-generated=true
departments/**/README.md    linguist-generated=true
departments/**/meta.json    linguist-generated=true
platform/courses/**/narration/lesson.json  linguist-generated=true
platform/courses/**/slides/index.html      linguist-generated=true
