  "capstone": {
    "title": "临床决策支持评估与批判",
    "deliverable": "对一个真实中医 AI 产品做完整评估报告：数据来源、性能指标、失效场景、伦理与合规风险，并给出改进方案。",
    "criteria": [
      "报告必须包含至少 3 个真实失效案例，并说明为什么会失效",
      "必须给出可核查的评估方法与原始数据",
      "必须明确写出该产品不应用于哪些临床场景"
    ]
