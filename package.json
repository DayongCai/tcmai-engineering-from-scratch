{
  "name": "tcmai-engineering-from-scratch",
  "version": "1.5.0",
  "private": true,
  "description": "中医药领域 1领域·8院系·120学科 —— 网络视频教育平台 [tcmP] 与教材编写流水线 [textbooks]",
  "license": "MIT",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build_catalog.js && node scripts/build_roadmap.js && node scripts/build_doc_indexes.js && node site/pages.js && node site/build.js",
