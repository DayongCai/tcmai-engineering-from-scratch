{
  "name": "tcmai-engineering-from-scratch",
  "version": "1.21.0",
  "private": true,
  "description": "中医药领域 1领域·8院系·120学科 —— 网络视频教育平台 [tcmP] 与教材编写流水线 [textbooks]",
  "license": "MIT",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build_catalog.js && node scripts/build_roadmap.js && node scripts/build_doc_indexes.js && node scripts/build_outputs_index.js && node site/pages.js && node site/build.js",
    "catalog": "node scripts/build_catalog.js",
    "roadmap": "node scripts/build_roadmap.js",
    "indexes": "node scripts/build_doc_indexes.js",
    "audit": "node scripts/audit_curriculum.js",
    "outputs": "node scripts/build_outputs_index.js",
    "dashboard": "node scripts/build_dashboard.js",
    "embeddings": "node scripts/build_embeddings.js",
    "descriptions": "node scripts/build_dsu_descriptions.js",
    "external:batch": "node scripts/external_batch.js",
    "api": "node scripts/tcm_api.js",
    "icd11": "node scripts/icd11_client.js",
    "icd11:ensure": "node scripts/icd11_client.js --ensure",
    "icd11:validate": "node scripts/icd11_client.js --validate",
    "icd11:metrics": "node scripts/icd11_embeddings.js",
    "links": "node scripts/check_links.js",
    "counts": "node scripts/check_readme_counts.js",
    "check": "node scripts/audit_curriculum.js && node scripts/check_readme_counts.js && node scripts/check_links.js --strict && node scripts/build_outputs_index.js --check",
    "site": "node site/pages.js && node site/build.js",
    "serve": "node site/serve.js",
    "test": "node tests/run_all.js",
    "tcmP:tools": "node platform/pipeline/check_tools.js",
    "tcmP:narration": "node platform/pipeline/extract_narration.js",
    "tcmP:slides": "node platform/pipeline/build_slides.js",
    "tcmP:frames": "node platform/pipeline/render_frames.js",
    "tcmP:tts": "node platform/pipeline/synthesize_narration.js",
    "tcmP:video": "node platform/pipeline/build_video.js",
    "scaffold:subject": "node scripts/scaffold_subject.js",
    "scaffold:chapter": "node scripts/scaffold_chapter.js"
  }
}
